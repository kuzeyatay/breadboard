# 用户产出（整目录不提交）
outputs/
disclosures/
tmp/
*.tmp
~$*

# 示例专利材料（仅提交 README 中的镜像链接；PDF/TXT 等本地自备）
examples/example_patent_reader/**
!examples/example_patent_reader/README.md

# 国知局抓取结果缓存
tools/_last_result*.html
tools/crawl/_last_result*.html
tools/crawl/_last_home.html

# Python / tools
tools/node_modules/
__pycache__/
*.py[cod]
.pyo
.venv/
venv/
.venv-step310/
tools/shared/.venv-step310/
tools/shared/cad-env/
*.egg-info/

# math_render 联调产物（tests/test_math_render.py 运行时生成）
tests/_math_test_figures/
tests/_math_test_out.md
tests/_math_test_bad.md

# 技能市场上架限制：不得提交 Obsidian Bases（*.base）；源稿用 *.base.yaml，拷库时再写成 .base
assets/obsidian/*.base

# OS
.DS_Store
Thumbs.db
