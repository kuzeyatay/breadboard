        "origin": "worker",
        "fence": "worker",
        "payload": {
          "exactVariants": [
            { "exactFields": ["state"], "fixed": { "state": "running" } },
            { "exactFields": ["state"], "fixed": { "state": "cancelling" } }
          ]
        }
      },
      "worker-heartbeat": {
        "origin": "worker",
        "fence": "worker",
