  "resourceAdmission": {
    "signal": "windows-commit",
    "sampledInsideSerializedDurableReservation": true,
    "pendingEstimatesAreAdditive": true,
    "reserveEqualityIsDenied": true,
    "oneHeavyweightClassAtATime": true,
    "packaged": {
      "modes": ["packaged"],
      "strategy": "fixed",
      "reserveFloorMb": 8192,
      "adaptiveProcessTreeGuard": false
    },
    "development": {
      "modes": ["lean", "hot"],
      "strategy": "max-floor-or-bounded-tenth-plus-guard",
      "reserveFloorMb": 4096,
      "commitLimitDivisor": 10,
      "derivedReserveMinimumMb": 1536,
      "derivedReserveMaximumMb": 8192,
      "guardBandMb": 256,
      "adaptiveProcessTreeGuard": true,
      "guardPollIntervalMs": 25,
      "manifestHardCeilingsRemain": true,
      "onlyDashboardMayIncreaseLiveCeiling": true,
      "onlyDashboardTerminatesAtGlobalReserve": true
    }
  },
  "jobSubmission": {
    "method": "POST",
    "path": "/v1/jobs",
    "requiredFields": ["jobType", "idempotencyKey", "requestPayload"],
    "optionalFields": ["gardenId", "conversationId", "inputUploads"],
    "forbiddenAuthorityFields": [
      "owner",
      "ownerPrincipal",
      "userId",
      "principal",
      "internalPrincipal",
      "jobId",
      "workerKind",
      "resourceClass",
      "inputManifestPath",
      "workspacePath",
      "checkpointPath",
      "resultPath"
