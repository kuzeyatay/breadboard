  },
  "jobOutputs": {
    "maximumContentBytes": 1048576,
    "maximumSerializedResponseBytes": 1114112,
    "checkpoint": {
      "method": "GET",
      "pathTemplate": "/v1/jobs/{jobId}/checkpoint"
    },
    "result": {
      "method": "GET",
      "pathTemplate": "/v1/jobs/{jobId}/result"
    },
    "response": {
      "type": "runtime-job-output",
      "protocolVersion": 1,
      "exactFields": ["type", "protocolVersion", "jobId", "kind", "content"],
      "kindValues": ["checkpoint", "result"],
      "content": "plain-finite-json-value",
      "bindings": ["requestedJobId", "requestedKind"],
      "denyUnknownFields": true
    }
  },
  "errorResponse": {
    "type": "runtime-error",
    "codes": [
      "INVALID_JOB_REQUEST",
      "JOB_SCOPE_FORBIDDEN",
      "JOB_NOT_FOUND",
      "JOB_CONFLICT",
      "JOB_OUTPUT_NOT_READY",
      "JOB_INPUT_TOO_LARGE",
      "JOB_INPUT_QUOTA_EXCEEDED",
      "JOB_CANCELLATION_QUOTA_EXCEEDED",
      "JOB_CANCELLED_BEFORE_SUBMISSION",
      "INVALID_SERVICE_REQUEST",
      "SERVICE_NOT_FOUND",
      "SERVICE_LEASE_CONFLICT",
      "BREADBOARD_RESOURCE_EXHAUSTED",
      "RUNTIME_UNAVAILABLE",
      "RUNTIME_INTERNAL_ERROR"
    ],
    "requiredFields": [
      "type",
      "protocolVersion",
      "code",
      "message",
      "retryable",
      "resource",
      "requiredHeadroomMb",
      "availableHeadroomMb"
    ],
    "denyUnknownFields": true,
    "retryableMustBeFalse": true,
    "resourceExhaustionEvidence": {
      "code": "BREADBOARD_RESOURCE_EXHAUSTED",
      "resource": "windows_commit",
      "requiredHeadroomMb": "positive-integer",
      "availableHeadroomMb": "nonnegative-integer",
      "mustBeNullForOtherCodes": true
    },
    "forbiddenFields": ["executable", "args", "cwd", "env", "token", "providerSecret"]
  },
  "ready": {
    "type": "runtime-ready",
    "requiredFields": [
      "type",
      "protocolVersion",
      "runtimePid",
      "controlBaseUrl",
      "controlToken",
      "dashboardUrl",
      "services"
    ]
  },
  "status": {
    "type": "runtime-status",
    "requiredFields": [
      "type",
      "protocolVersion",
      "runtimePid",
      "acceptingWork",
      "services"
    ]
  },
  "serviceStatus": {
    "requiredFields": [
      "id",
      "displayName",
      "required",
      "startupPolicy",
      "state",
      "lastError",
      "restarts",
      "adopted"
    ],
    "states": [
      "available-but-stopped",
      "starting",
      "ready",
      "busy",
      "resource-blocked",
      "installation-unavailable",
      "failed",
      "stopping"
    ],
    "startupPolicies": ["eager", "on-demand", "scheduled", "external"],
    "maximumRecords": 256,
    "maximumIdBytes": 128,
    "maximumDisplayNameBytes": 256,
    "maximumLastErrorBytes": 8192,
    "maximumRestarts": 64,
    "adoptedMustBeFalse": true
  },
  "control": {
    "origin": "literal-loopback-http",
    "allowedHosts": ["127.0.0.1", "[::1]"],
    "authorizationScheme": "Bearer",
    "minimumTokenBytes": 32,
    "maximumTokenBytes": 1024,
    "maximumResponseBytes": 65536,
    "maximumJsonSafeInteger": 9007199254740991,
    "maximumActiveConnections": 40,
    "maximumActiveDashboardConnections": 32,
    "maximumDashboardJobConnections": 16,
    "maximumDashboardServiceConnections": 8,
    "minimumCrossRealmDashboardReserve": 8,
    "minimumLifecycleConnectionReserve": 8,
    "requestPreludeDeadlineMs": 2000,
    "developmentRequestPreludeDeadlineMs": 60000,
    "requestReadDeadlineMs": 2000,
    "responseWriteDeadlineMs": 2000,
    "responseDeadlineStartsAfterHandler": true,
    "overloadBehavior": "authenticated-dashboard-503-with-lifecycle-handler-reserve",
    "authorityRoles": {
      "lifecycle": ["status", "shutdown"],
      "dashboard": [
        "status",
        "submitJob",
        "lookupJob",
        "cancelJobByIdempotencyKey",
        "submitLearnRecovery",
        "inspectJob",
        "replayJobEvents",
        "cancelJob",
        "reserveJobInput",
        "uploadJobInput",
        "abandonJobInput",
        "readJobCheckpoint",
        "readJobResult",
        "readServiceLeaseContract",
        "acquireServiceLease",
        "releaseLease"
      ],
      "bearersMustBeDistinct": true,
      "unclassifiedRoutes": "deny"
    },
    "status": { "method": "GET", "path": "/v1/status" },
    "submitJob": { "method": "POST", "path": "/v1/jobs" },
    "lookupJob": { "method": "POST", "path": "/v1/jobs/lookup" },
    "cancelJobByIdempotencyKey": {
      "method": "POST",
      "path": "/v1/jobs/cancel-by-idempotency"
    },
    "submitLearnRecovery": {
      "method": "POST",
      "path": "/v1/internal/jobs/learn-recovery"
    },
    "inspectJob": { "method": "GET", "pathTemplate": "/v1/jobs/{jobId}" },
    "replayJobEvents": {
      "method": "GET",
      "pathTemplate": "/v1/jobs/{jobId}/events?after={sequence}&limit={limit}"
    },
    "cancelJob": { "method": "POST", "pathTemplate": "/v1/jobs/{jobId}/cancel" },
    "reserveJobInput": { "method": "POST", "path": "/v1/job-inputs" },
    "uploadJobInput": { "method": "PUT", "pathTemplate": "/v1/job-inputs/{uploadId}" },
    "abandonJobInput": {
      "method": "POST",
      "pathTemplate": "/v1/job-inputs/{uploadId}/abandon"
    },
    "readJobCheckpoint": {
      "method": "GET",
      "pathTemplate": "/v1/jobs/{jobId}/checkpoint"
    },
    "readJobResult": {
      "method": "GET",
      "pathTemplate": "/v1/jobs/{jobId}/result"
    },
    "readServiceLeaseContract": {
      "method": "GET",
      "pathTemplate": "/v1/services/{serviceId}/lease-contract"
    },
    "acquireServiceLease": {
      "method": "POST",
      "pathTemplate": "/v1/services/{serviceId}/lease"
    },
    "releaseLease": {
      "method": "POST",
      "pathTemplate": "/v1/leases/{leaseId}/release"
    },
    "shutdown": { "method": "POST", "path": "/v1/shutdown" },
    "shutdownResponse": { "ok": true }
  }
}
