              "exactFields": ["state", "failureCode", "failureMessage"],
              "fixed": {
                "state": "failed",
                "failureCode": "WORKER_FAILED",
                "failureMessage": "Runtime job execution failed."
              }
            },
            { "exactFields": ["state"], "fixed": { "state": "cancelling" } }
          ]
        }
      },
      "worker-cancellation-acknowledged": {
        "origin": "worker",
        "fence": "worker",
        "payload": { "exactFields": ["state"], "fixed": { "state": "cancelling" } }
      },
      "job-starting": {
