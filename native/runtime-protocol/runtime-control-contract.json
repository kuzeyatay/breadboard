        }
      },
      "worker-complete": {
        "origin": "worker",
        "fence": "worker",
        "payload": { "exactFields": [], "fixed": {} }
      },
      "worker-failed": {
        "origin": "worker",
        "fence": "worker",
        "payload": {
          "exactVariants": [
