    "denyUnknownFields": true,
    "maximumBodyBytes": 262144,
    "maximumJobTypeBytes": 128,
    "maximumIdempotencyKeyBytes": 256,
    "idempotencyKeyGrammar": "nonempty-unicode-without-control-characters",
    "maximumScopeIdBytes": 256,
    "requestPayload": "plain-finite-json-value",
    "maximumJsonNodesBeforeSerialization": 100000,
    "inputUploads": {
      "maximumCount": 16,
      "itemFields": ["uploadId"],
      "uniqueUploadIds": true,
      "metadataAuthority": "runtime-upload-ledger",
      "callerPathsForbidden": true
    }
  },
  "jobInputUploads": {
    "authority": "dashboard-server-bearer-and-job-authority-headers",
    "maximumUploadBytes": 2147483648,
    "aggregateQuota": {
      "accounting": "all-upload-ledger-rows-with-cleanedAt-null-including-adopted",
      "perOwnerMaximumCount": 16,
      "perOwnerMaximumDeclaredBytes": 4294967296,
      "globalMaximumCount": 256,
      "globalMaximumDeclaredBytes": 17179869184,
      "enforcement": "same-immediate-sqlite-transaction-as-reservation",
      "errorCode": "JOB_INPUT_QUOTA_EXCEEDED"
    },
    "reservation": {
      "method": "POST",
      "path": "/v1/job-inputs",
      "maximumBodyBytes": 16384,
      "requestFields": ["gardenId", "conversationId", "displayName", "mediaType", "declaredSizeBytes"],
      "responseFields": ["uploadId", "expiresAt", "maximumBytes"],
      "expiresAt": "positive-future-json-safe-integer",
      "denyUnknownFields": true
    },
    "stream": {
      "method": "PUT",
      "pathTemplate": "/v1/job-inputs/{uploadId}",
      "contentType": "application/octet-stream",
      "framing": "bounded-content-length-or-chunked",
      "digestAuthority": "rust-stream-and-trusted-reopen",
      "responseFields": ["type", "protocolVersion", "uploadId", "state", "sizeBytes", "sha256"],
      "responseFixed": { "type": "runtime-job-input", "protocolVersion": 1, "state": "sealed" },
      "denyUnknownResponseFields": true
    },
    "abandon": {
      "method": "POST",
      "pathTemplate": "/v1/job-inputs/{uploadId}/abandon",
      "responseFields": ["ok"],
      "okMustBeTrue": true,
      "idempotent": true,
      "denyUnknownResponseFields": true
    },
    "lifecycleStates": ["pending", "uploading", "sealed", "adopted", "abandoning", "abandoned", "expired", "cleanup_blocked"],
    "adoptionPathTemplate": "runtime/jobs/{jobId}/inputs/{blobId}/payload",
    "uploadIsNeverAJob": true
  },
  "jobLookup": {
    "method": "POST",
    "path": "/v1/jobs/lookup",
    "maximumBodyBytes": 1024,
    "requestFields": ["idempotencyKey"],
    "authority": "dashboard-server-bearer-and-job-authority-headers",
    "ownerAndScopesForbiddenInBody": true,
    "response": "runtime-job-or-job-not-found",
    "idempotencyKeyNeverReturned": true,
    "denyUnknownFields": true
  },
  "jobIdempotencyCancellation": {
    "method": "POST",
    "path": "/v1/jobs/cancel-by-idempotency",
    "maximumBodyBytes": 1024,
    "requestFields": ["idempotencyKey"],
    "authority": "dashboard-server-bearer-and-exact-job-authority-headers",
    "ownerAndScopesForbiddenInBody": true,
    "idempotencyKeyNeverReturned": true,
    "tombstoneTtlMs": 86400000,
    "aggregateQuota": {
      "perOwnerMaximumCount": 128,
      "globalMaximumCount": 4096,
      "enforcement": "same-immediate-sqlite-transaction-as-cancellation",
      "errorCode": "JOB_CANCELLATION_QUOTA_EXCEEDED"
    },
    "onlineCleanup": {
      "maximumBatch": 64,
      "periodicBatch": 8,
      "touchesOnlyExpiredTombstones": true
    },
    "submissionRace": "active-tombstone-is-consumed-in-the-job-insert-transaction-and-job-is-never-admission-visible-before-terminal-cancelled",
    "response": {
      "type": "runtime-job-idempotency-cancellation",
      "protocolVersion": 1,
      "exactFields": ["type", "protocolVersion", "jobId", "state", "accepted"],
      "pendingDisposition": { "jobId": null, "state": "pending", "accepted": true },
      "acceptedJobStates": ["cancelling", "cancelled"],
      "alreadyTerminalStates": ["succeeded", "failed", "resource_exhausted", "interrupted", "uncertain"],
      "alreadyTerminalAccepted": false,
      "denyUnknownFields": true
    },
    "denyUnknownFields": true
  },
  "learnRecoverySubmission": {
    "method": "POST",
    "path": "/v1/internal/jobs/learn-recovery",
    "maximumBodyBytes": 1024,
    "requestFields": ["idempotencyKey"],
    "idempotencyKeyGrammar": "learn-recovery-v2-colon-decimal-generation",
    "authority": "dashboard-server-bearer-only",
    "authorityHeadersForbidden": ["x-breadboard-user-id", "x-breadboard-garden-id", "x-breadboard-conversation-id"],
    "fixedInternalPrincipal": "internal:learn-recovery",
    "fixedJobType": "learn",
    "fixedScopes": { "gardenId": null, "conversationId": null },
    "fixedRequestPayload": { "operation": "recovery" },
    "fixedInputUploads": [],
    "forbiddenBodyFields": ["jobType", "requestPayload", "inputUploads", "owner", "ownerPrincipal", "principal", "userId", "gardenId", "conversationId"],
    "normalSubmissionAdmissionGateApplies": true,
    "response": "runtime-job",
    "denyUnknownFields": true
  },
  "jobAuthorityHeaders": {
    "required": ["x-breadboard-user-id"],
    "optional": ["x-breadboard-garden-id", "x-breadboard-conversation-id"],
    "rejectDuplicates": true,
    "userId": "positive-json-safe-integer-decimal",
    "scopeGrammar": "visible-ascii-without-whitespace",
    "scopeValuesMustMatchSubmission": true,
    "neverRendererAccessible": true
  },
  "serviceLeaseControl": {
    "authority": "dashboard-server-bearer-only",
    "maximumBodyBytes": 8192,
    "maximumReasonBytes": 256,
    "reasonGrammar": "nonempty-unicode-without-control-characters",
    "serviceIdentityAuthority": "authenticated-route-and-trusted-service-registry",
    "leaseDurationAuthority": "trusted-service-registry",
    "acquireDeadline": {
      "method": "GET",
      "pathTemplate": "/v1/services/{serviceId}/lease-contract",
      "requestBody": "none",
      "responseFields": ["protocolVersion", "serviceId", "acquireTimeoutMs"],
      "responseBinding": "requested-service-id",
      "startupTimeoutAuthority": "trusted-service-registry-readiness",
      "maximumManifestStartupMs": 604800000,
      "settlementGraceMs": 5000,
      "responseGraceMs": 5000,
      "dashboardTransportGraceMs": 5000,
      "passive": true,
      "denyUnknownFields": true
    },
    "acquire": {
      "method": "POST",
      "pathTemplate": "/v1/services/{serviceId}/lease",
      "requestFields": ["reason"],
      "forbiddenRequestFields": [
        "serviceId",
        "maximumLeaseMs",
        "executable",
        "args",
        "cwd",
        "env"
      ],
      "responseFields": ["ok", "leaseId", "serviceId"],
      "okMustBeTrue": true,
      "responseBinding": "requested-service-id",
      "responseDeliveryFailure": "release-returned-lease-immediately",
      "denyUnknownFields": true
    },
    "release": {
      "method": "POST",
      "pathTemplate": "/v1/leases/{leaseId}/release",
      "requestFields": [],
      "requestBody": "exact-empty-json-object",
      "responseFields": ["ok", "released"],
      "okMustBeTrue": true,
      "denyUnknownFields": true
    }
  },
