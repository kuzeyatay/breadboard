    "eventRules": {
      "queued": {
        "origin": "runtime",
        "fence": "runtime-zero",
        "payload": { "exactFields": ["state"], "fixed": { "state": "queued" } }
      },
      "admitted": {
        "origin": "runtime",
        "fence": "runtime-zero",
        "payload": { "exactFields": ["state"], "fixed": { "state": "admitted" } }
      },
      "worker-assigned": {
        "origin": "runtime",
        "fence": "runtime-attempt",
        "payload": { "exactFields": ["state"], "fixed": { "state": "starting" } }
