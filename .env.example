# Root-level environment for running the full Breadboard stack.
#
# Most configuration lives in dashboard/.env.local (see dashboard/.env.example).
# These variables are read by the OpenHarness startup scripts.

# Interactive routing. required never bypasses OpenHarness; preferred permits a
# visible/audited legacy fallback; legacy intentionally uses direct ChatMock.
OPENHARNESS_ENABLED=true
OPENHARNESS_MODE=required
OPENHARNESS_BASE_URL=http://127.0.0.1:4096

# OpenHarness server password (shared with the dashboard's OPENHARNESS_PASSWORD).
# This local default matches the launchers; replace it for anything shared.
OPENHARNESS_PASSWORD=breadboard-local-dev
OPENHARNESS_USERNAME=breadboard
OPENHARNESS_PORT=4096

# ChatMock is OpenHarness's OpenAI-compatible model provider.
CHATMOCK_BASE_URL=http://127.0.0.1:8765/v1
CHATMOCK_API_KEY=local
CHATMOCK_MODEL=gpt-5.6-sol

# Quartz builds embed this as the dashboard API base URL the page AI panel calls.
BREADBOARD_DASHBOARD_URL=http://localhost:3000
