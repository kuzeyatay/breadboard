# Root-level environment for running the full Breadboard stack.
#
# Most configuration lives in dashboard/.env.local (see dashboard/.env.example).
# These variables are read by the Hermes startup scripts.

# --- Hermes runtime ---------------------------------------------------------
# Hermes is Breadboard's conversational runtime. Codex is a separate coding
# agent and does not participate in this selection.
# Optional Codex coding-agent executable. Resolution otherwise checks a binary
# built from ./codex, the packaged binary, and then PATH.
CODEX_BIN=

# Optional override for the cloned ARIS autonomous-research skill repository.
# By default Breadboard discovers ./auto-claude-code-research-in-sleep.
ARIS_ROOT=

# --- HyperFrames video agent ------------------------------------------------
# All optional: each piece is discovered before these are consulted. The CLI is
# looked for in a built ./hyperframes clone, then Breadboard's own npm prefix
# (dashboard/hyperframes-cli), then PATH; ffmpeg in agent-reach/.tools/bin, then
# PATH; the browser among installed Chrome/Edge locations. Set one only to pin it.
HYPERFRAMES_ROOT=
HYPERFRAMES_BIN=
HYPERFRAMES_FFMPEG_PATH=
HYPERFRAMES_FFPROBE_PATH=
HYPERFRAMES_BROWSER_PATH=
# Where scaffolded video projects and their renders are kept.
HYPERFRAMES_WORKSPACE_ROOT=
# Loopback-only Hermes gateway. The token and tool secret are dev credentials:
# keep the real values in dashboard/.env.local (git-ignored), which the
# launchers also read so the dashboard and the Hermes child cannot drift apart.
HERMES_PORT=9129
HERMES_BASE_URL=http://127.0.0.1:9129
HERMES_DASHBOARD_SESSION_TOKEN=
BREADBOARD_HERMES_TOOL_SECRET=
HERMES_CAPABILITY_SECRET=
HERMES_REQUEST_TIMEOUT_MS=120000
HERMES_MODE=required
HERMES_ROOT=
HERMES_SKILLS_QUARANTINE=
HERMES_SKILLS_APPROVED=
HERMES_SKILLS_CONDITIONAL=
HERMES_FIRST_PARTY_SKILLS_ROOT=
# Optional: python interpreter for the Hermes checkout. Defaults to
# hermes-agent/.venv, then the system python.
HERMES_PYTHON=

# --- Agent Loop Engineering Kit ---------------------------------------------
# The cloned kit designs, validates and dry-runs bounded agent loop contracts
# for the `agent-loop-engineering` skill. Defaults to the checkout at
# agent-loop-engineering-kit/ and its .venv; both are optional overrides.
BREADBOARD_AGENT_LOOP_ROOT=
BREADBOARD_AGENT_LOOP_PYTHON=

# Server-only public catalog proxy. Desktop injects its packaged default;
# ordinary dashboard development reads this value directly.
BREADBOARD_SKILLS_CATALOG_URL=https://breadboard-skills-catalog-kuzeyatay.vercel.app/api/v1

# ChatMock is the OpenAI-compatible model provider for the interactive runtime
# and for UI-TARS browser agents (their default provider, so no per-agent key).
CHATMOCK_BASE_URL=http://127.0.0.1:8765/v1
CHATMOCK_API_KEY=local
# `default` follows the background model chosen in Settings -> Providers, so a
# change there applies without restarting Hermes/UI-TARS/research.
# Pin a specific id here (e.g. gpt-5.6-sol, anthropic/claude-opus-4-5) to opt out.
CHATMOCK_MODEL=default

# --- Local speech (Voicebox) -----------------------------------------------
# Voicebox provides private text-to-speech and Whisper dictation. The full dev
# launcher starts the cloned checkout and prepares its isolated Python
# environment automatically in the background on first launch.
VOICEBOX_BASE_URL=http://127.0.0.1:17493
VOICEBOX_PORT=17493
VOICEBOX_AUTOSTART=true
# First launch prepares the isolated Python environment and dependencies in the
# background. Set false only for an intentionally externally-managed Voicebox.
VOICEBOX_AUTOINSTALL=true
VOICEBOX_PYTHON=
VOICEBOX_DATA_DIR=
VOICEBOX_MODELS_DIR=

# --- Subscriptions (no API key) ---------------------------------------------
# CLIProxyAPI runs as an optional loopback service and signs into AI plans you
# already pay for (Claude Pro/Max, ChatGPT, Google/Gemini via Antigravity, Kimi,
# Grok) over OAuth. ChatMock exposes them as `cliproxy/<model>`. Connect accounts
# in Settings -> Providers; nothing here is required.
# `required` (default) treats a failure to start as fatal to the stack, because
# without it every subscription model silently disappears. `optional` starts it
# but never blocks — use that if you may be offline on a machine that has not
# downloaded the binary yet. `disabled` skips it entirely.
CLIPROXY_MODE=required
CLIPROXY_PORT=8317
# Leave blank: the loopback bearer and management key are generated per install
# under CLIPROXY_HOME (default ~/.breadboard/cliproxy) and shared automatically.
CLIPROXY_API_KEY=
# Pin a release instead of tracking the latest, e.g. 7.2.111.
CLIPROXY_VERSION=

# --- Model providers (API keys, billed per token) ---------------------------
# These are NOT offered in the settings UI and their keys below are IGNORED by
# default: a stray OPENAI_API_KEY (often ChatMock's own `local` placeholder)
# would otherwise mark a provider configured and fill the model picker with ids
# that answer 401. Set this to 1 only for a headless/CI deployment that really
# does supply purchased keys through the environment.
CHATMOCK_ALLOW_ENV_PROVIDER_KEYS=
# ChatMock reaches ChatGPT through OAuth (Settings -> Account). Other providers
# are configured in Settings -> Providers, which stores keys next to ChatMock's
# auth.json. These variables are fallbacks for headless/CI setups; a key stored
# through the UI takes precedence. Model ids are provider-prefixed:
#   anthropic/claude-opus-4-5, google/gemini-2.5-pro, openrouter/<vendor>/<model>
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
# Any other OpenAI-compatible server — including a local Ollama, at
# http://127.0.0.1:11434/v1 — is reached through the `custom` provider. It needs
# no key, only a base URL, and stays unconfigured until one is supplied (so it
# never advertises models that nothing is serving).
CUSTOM_OPENAI_BASE_URL=
CUSTOM_OPENAI_API_KEY=

# --- Connected apps ---------------------------------------------------------
# Active broker: Composio managed connections. The API key stays server-side;
# users authorize their own accounts through Composio Connect Links.
COMPOSIO_API_KEY=
COMPOSIO_USER_ID_PREFIX=breadboard
# Optional toolkit -> auth-config override for project-owned/custom configs.
COMPOSIO_AUTH_CONFIGS_JSON=

# Retained direct-OAuth fallback (currently inactive).
BREADBOARD_PUBLIC_URL=http://localhost:3000
# Optional base64-encoded 32-byte vault key. When empty, Breadboard derives a
# separate vault key from NEXTAUTH_SECRET, which must remain stable.
BREADBOARD_CONNECTION_VAULT_KEY=
# Register this callback in each provider's developer application:
# http://localhost:3000/api/hermes/connections/oauth/callback
# Google covers Gmail + Calendar; Microsoft covers Outlook + Calendar + Teams.
BREADBOARD_GOOGLE_CLIENT_ID=
BREADBOARD_GOOGLE_CLIENT_SECRET=
BREADBOARD_MICROSOFT_CLIENT_ID=
BREADBOARD_MICROSOFT_CLIENT_SECRET=
BREADBOARD_GITHUB_CLIENT_ID=
BREADBOARD_GITHUB_CLIENT_SECRET=
BREADBOARD_SLACK_CLIENT_ID=
BREADBOARD_SLACK_CLIENT_SECRET=
BREADBOARD_NOTION_CLIENT_ID=
BREADBOARD_NOTION_CLIENT_SECRET=
# Optional server-side map for other static OAuth2 providers in the catalog:
# {"provider-slug":{"client_id":"...","client_secret":"..."}}
BREADBOARD_OAUTH_CREDENTIALS_JSON=

# Quartz builds embed this as the dashboard API base URL the page AI panel calls.
BREADBOARD_DASHBOARD_URL=http://localhost:3000

# Scriberr (video transcription service; see dashboard/.env.example for the
# full set of dashboard-side variables). scripts/start-scriberr.mjs uses these
# to launch the bundled native Windows sidecar. Port 8080 is taken by Reader
# locally, so Scriberr uses 8091 by default. Docker is not required.
SCRIBERR_PORT=8091
SCRIBERR_BASE_URL=http://127.0.0.1:8091
# Optional: skip starting Scriberr with the rest of the stack.
SCRIBERR_AUTOSTART=true

# --- OfficeCLI (office_run/office_export agent tools + Office skills tab) ----
# Real .docx/.xlsx/.pptx authoring via the pinned OfficeCLI binary
# (github.com/iOfficeAI/OfficeCLI, release v1.0.143 — the vendored OfficeCLI/
# clone is checked out at the same tag). Provision with `npm run setup:officecli`,
# which installs into .runtime/officecli with checksum verification. Set
# OFFICECLI_BIN only to pin a different binary; OFFICE_SKILLS_ROOT only if the
# clone (and its skills/ tree) lives somewhere other than ./OfficeCLI.
OFFICECLI_BIN=
OFFICE_SKILLS_ROOT=

# --- PenEcho (whiteboard cards in garden notes) -----------------------------
# A ```penecho block in a note becomes a whiteboard card, drawn on the vendored
# PenEcho canvas server (./penecho). The dashboard starts it on demand — no
# install step, no Docker — and points it at ChatMock, so a board answers on
# the household model. Leave these unset for the local defaults.
PENECHO_PORT=8092
# Set only to use a canvas server Breadboard does not supervise. When set, the
# dashboard never starts one, and Quartz builds bake this into the cards.
PENECHO_URL=
# The model the canvas sends its handwriting to. Defaults to the house model.
PENECHO_MODEL=
# Boards, logs and private plugins. Defaults to .runtime/penecho.
PENECHO_STATE_DIR=

# --- GBrain (garden knowledge retrieval) -----------------------------------
# GBrain is Breadboard's DERIVED retrieval layer (chunks, embeddings, indexes).
# It never replaces conversation memory and never owns canonical garden content.
# Modes: disabled (no adapter, no tools), preferred (runs; degrades visibly when
# unavailable), required (startup fails if the adapter is unhealthy). `preferred`
# is also what an unset GBRAIN_MODE resolves to, so GBrain is on by default.
GBRAIN_MODE=preferred
# Loopback-only adapter. The dev launcher generates a per-launch secret when this
# is empty and shares it with the dashboard; set it explicitly for a stable dev
# secret. The browser never receives it.
GBRAIN_ADAPTER_URL=http://127.0.0.1:7717
GBRAIN_ADAPTER_PORT=7717
GBRAIN_ADAPTER_SECRET=
# Mutable PGLite/index data lives here, OUTSIDE the checkout. Defaults to
# ~/.breadboard/gbrain when empty (desktop overrides to the userData dir).
GBRAIN_DATA_DIR=
# Backend: `gbrain` (production, the vendored GBrain engine) is the default.
# `fake` is a deterministic test-only store and is REFUSED in packaged production.
GBRAIN_BACKEND=gbrain
# Embeddings. Left empty, all five fall back to ChatMock's local `/v1/embeddings`
# (an ONNX model on the CPU, no key), so retrieval is genuinely hybrid out of the
# box. Set them to point at a paid OpenAI-compatible endpoint instead, or set
# GBRAIN_EMBEDDING_PROVIDER=none for honest lexical_degraded retrieval.
# `deterministic-test` is a reproducible offline embedder for tests only
# (rejected unless GBRAIN_TEST_MODE=1).
GBRAIN_EMBEDDING_PROVIDER=
GBRAIN_EMBEDDING_BASE_URL=
GBRAIN_EMBEDDING_API_KEY=
GBRAIN_EMBEDDING_MODEL=
GBRAIN_EMBEDDING_DIMENSIONS=
GBRAIN_QUERY_TIMEOUT_MS=15000

# --- UI-TARS browser-operator runtime agent -------------------------------
# Browser-only Agent TARS runtime, launched from the Agents page via a
# Breadboard-owned loopback adapter. Breadboard remains the control plane.
# Modes: disabled (no adapter; agent shown disabled), optional (runs; degrades
# to a visible unavailable state), required (dev/dedicated only; may fail start).
UI_TARS_MODE=optional
# Loopback-only adapter. The dev launcher generates a per-launch secret when
# empty and shares it with the dashboard; the browser NEVER receives it.
UI_TARS_ADAPTER_URL=http://127.0.0.1:7719
UI_TARS_ADAPTER_PORT=7719
UI_TARS_ADAPTER_SECRET=
# Mutable data (screenshots, ISOLATED browser profiles, session registry) lives
# here, OUTSIDE the checkout. Defaults to ~/.breadboard/ui-tars when empty.
UI_TARS_DATA_DIR=
# Runtime backend: `agent-tars` (real Puppeteer browser via @agent-tars/core) is
# the default. `fake` is a deterministic test-only runtime and must NOT be used
# to satisfy real-browser acceptance criteria.
UI_TARS_RUNTIME=agent-tars
UI_TARS_MAX_CONCURRENT_RUNS=3
UI_TARS_SCREENSHOT_RETENTION_MS=86400000
# Provider API keys are NOT set here — they are configured per-agent in the
# Agents page and stored server-side only (never in env, argv, logs, or the
# browser). Configure the model provider/model/endpoint per agent.

# --- Deep Research agent ----------------------------------------------------
# Iterative web research (open-deep-research engine in ./deep-research) behind a
# Breadboard-owned loopback service, opened from the capability palette's Agents
# tab. Its LLM is ChatMock (CHATMOCK_* above), so no provider key is needed.
# Modes match UI-TARS: disabled | optional | required.
DEEP_RESEARCH_MODE=optional
DEEP_RESEARCH_URL=http://127.0.0.1:7722
DEEP_RESEARCH_PORT=7722
# Loopback-only. The dev launcher generates a per-launch secret when empty and
# shares it with the dashboard; the browser NEVER receives it.
DEEP_RESEARCH_SECRET=
DEEP_RESEARCH_MAX_CONCURRENT_RUNS=2
# Per-model-step budget. Reasoning models behind the local gateway are slower
# than the engine's upstream default assumes.
DEEP_RESEARCH_STEP_TIMEOUT_MS=180000
# Search backend: auto | chatmock | firecrawl.
#  - chatmock (the default under `auto`): ChatMock's built-in web_search tool.
#    Needs no third-party key — searches run upstream and come back cited.
#  - firecrawl: real SERP results scraped to markdown; needs FIRECRAWL_KEY
#    (hosted) or FIRECRAWL_BASE_URL (self-hosted).
# With neither backend usable, runs are refused with a clear message instead of
# producing an empty report.
DEEP_RESEARCH_SEARCH_PROVIDER=auto
FIRECRAWL_KEY=
FIRECRAWL_BASE_URL=
# Parallel searches per round, and the budget for one search call. ChatMock's
# web search is a full upstream model call, so it is slow by nature.
DEEP_RESEARCH_CONCURRENCY=2
DEEP_RESEARCH_SEARCH_TIMEOUT_MS=300000

# Optional developer override for the Agency Agents persona catalog.
# Desktop builds bundle the catalog and normal checkouts discover it automatically.
AGENCY_AGENTS_PATH=

# First-party interactive visualization artifact publication. The browser gate
# is mandatory: disabling it disables this capability without affecting chat.
INTERACTIVE_VISUALIZER_ENABLED=true
INTERACTIVE_VISUALIZER_BROWSER_TESTS=true
INTERACTIVE_VISUALIZER_THREE_ENABLED=true
INTERACTIVE_VISUALIZER_MAX_ATTEMPTS=3
INTERACTIVE_VISUALIZER_MAX_SOURCE_BYTES=80000
INTERACTIVE_VISUALIZER_MAX_BUNDLE_BYTES=1000000
INTERACTIVE_VISUALIZER_MAX_ARTIFACT_BYTES=2000000
INTERACTIVE_VISUALIZER_BROWSER_TIMEOUT_MS=22000
INTERACTIVE_VISUALIZER_MAX_THREE_OBJECTS=256
INTERACTIVE_VISUALIZER_MAX_VERTICES=100000

# --- Maps (OpenStreetMap: Photon, Nominatim, Valhalla, Overpass) ---------
# The mapping system behind /map and the agent's map_* tools. Every geographic
# fact in an answer comes from these services; the model is never the source.
# The defaults are the public OSM-community endpoints, which are rate-limited —
# point them at self-hosted instances for anything beyond personal use.
# MAP_ENABLED=false removes the page, the API and the map_* tools entirely.
MAP_ENABLED=true
# Forward geocoding and autocomplete. Photon rather than Nominatim on purpose:
# Nominatim's usage policy forbids keystroke-rate querying.
MAP_GEOCODER_URL=https://photon.komoot.io
# Reverse geocoding and place details (opening hours, phone, website, raw tags).
MAP_REVERSE_GEOCODER_URL=https://nominatim.openstreetmap.org
# Routing. Its distance and duration are authoritative and are never recomputed.
MAP_ROUTER_URL=https://valhalla1.openstreetmap.de
# POI queries.
MAP_OVERPASS_URL=https://overpass-api.de/api/interpreter
# MapLibre basemap style document.
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Contact string sent as User-Agent; Nominatim's policy requires a real one.
MAP_USER_AGENT=
MAP_REQUEST_TIMEOUT_MS=12000
MAP_ROUTER_TIMEOUT_MS=25000
MAP_OVERPASS_TIMEOUT_MS=30000

# --- Recall (local screen + audio history, powered by the screenpipe engine) ---
# Capture is opt-in per user in Settings -> Recall; nothing here starts a
# recorder on its own. RECALL_ENABLED=false removes the tab, the routes, and the
# recall_* agent tools entirely.
RECALL_ENABLED=true
# Loopback API of the capture engine. 3030 is what screenpipe's own CLI and MCP
# server default to, so change it only if that port is taken.
RECALL_BASE_URL=http://127.0.0.1:3030
# Breadboard-owned home for the installed engine, its data, its pid file and log.
# Defaults to ~/.breadboard/recall; the desktop app points this at its data root.
RECALL_HOME=
RECALL_DATA_DIR=
# Bearer token for the engine's loopback API, which every read of captured
# history needs (only /health is open). Leave this empty unless you run the
# engine yourself: Breadboard mints a key into RECALL_HOME/api-key on first
# start and launches the engine with it. `screenpipe auth token` cannot be used
# to discover it — that command reads the engine's default data directory, not
# the one Breadboard passes with --data-dir.
RECALL_API_KEY=
# Version of the `screenpipe` npm CLI the installer pins. Bumping this is what
# an upgrade looks like; the install button downloads exactly this version.
RECALL_CLI_VERSION=0.4.37
# Hard ceilings applied on top of the user's own per-answer limits.
RECALL_MAX_RESULTS=20
RECALL_MAX_RESULT_CHARS=1200
# Only read by scripts/start-screenpipe.mjs, for running the recorder in a dev
# stack without a signed-in user. Off by default so `dev-all` never records.
RECALL_CAPTURE=false

# --- Image to 3D (Stable Fast 3D) -------------------------------------------
# Attach a picture, ask for a 3D model, get a GLB artifact. See
# docs/IMAGE_TO_3D.md. Provision once with `npm run setup:sf3d`; nothing here
# installs anything or starts a download by itself.
#
# The model weights are ACCESS-GATED on Hugging Face. Request access at
# https://huggingface.co/stabilityai/stable-fast-3d, create a read token, and
# put it here — without it the first reconstruction fails with a 401 that reads
# like a network error.
HUGGINGFACE_TOKEN=
# The vendored Stability checkout, and the pinned Python 3.12 environment the
# setup script builds. Both default to the repository layout.
SF3D_ROOT=
SF3D_VENV=
SF3D_PYTHON=
# Force a device. Empty picks the best available (cuda, then mps, then cpu) —
# and note that a CPU-only machine cannot run this at all: the texture baker has
# CUDA and Metal kernels and no CPU path.
SF3D_DEVICE=
# Texture atlas resolution: 256, 512, 1024 or 2048. 1024 is what the model was
# tuned for; 2048 roughly doubles peak GPU memory.
SF3D_TEXTURE_RESOLUTION=1024
# Default remesher: none, triangle or quad.
SF3D_REMESH=none
# Ceiling for one reconstruction. Generous because the first call also downloads
# roughly a gigabyte of weights.
SF3D_TIMEOUT_MS=300000
SF3D_PRETRAINED_MODEL=stabilityai/stable-fast-3d

# --- Formsmith (ShapeR) -----------------------------------------------------
# The ShapeR checkout and its provisioned Python 3.10/CUDA environment.
# Defaults to ./ShapeR and ./ShapeR/.venv when those paths exist. See
# docs/SHAPER_INTEGRATION.md. Runtime requests never install dependencies.
SHAPER_ROOT=
SHAPER_PYTHON=


# --- SolidWorks CAD backend (optional, Windows only) -------------------------
# Hardware Blueprint can build its mechanical CAD in SolidWorks instead of
# CadQuery. This is opt-in per user, in the Hardware Blueprint settings or with
# `--cad solidworks` on one message; without it nothing here is read and nothing
# is started. SolidWorks itself is commercial software that must already be
# installed and licensed — only the Breadboard integration and the MCP bridge
# are open source. See docs/SOLIDWORKS_BACKEND.md.
#
# The already-cloned https://github.com/andrewbartels1/SolidworksMCP-python.
# Breadboard never clones or installs it; a sibling checkout next to this
# repository is discovered automatically, and this pins it anywhere else.
BREADBOARD_SOLIDWORKS_MCP_PATH=
# Optional overrides. The executable is otherwise found under
# "Program Files/SOLIDWORKS Corp", and the release year is read from that path.
BREADBOARD_SOLIDWORKS_EXE=
BREADBOARD_SOLIDWORKS_VERSION=
# Where generated .SLDPRT files are written before they are stored. Defaults to
# <BREADBOARD_DATA_DIR>/solidworks/workspaces. Never a directory of your own.
BREADBOARD_SOLIDWORKS_WORKSPACE=
# --- Resource2Skill (distilled Web/PPT/Excel/Blender/audio runtime) ----------
# The Microsoft clone defaults to ./Resource2Skill. Provision its isolated
# Python 3.11 environment with `npm run setup:resource2skill`. Add -- --with-web
# for Playwright Chromium or -- --with-blender for the optional bpy wheel.
RESOURCE2SKILL_ROOT=
RESOURCE2SKILL_VENV=
# Durable, per-run outputs. Defaults to dashboard/resource2skill-runs in dev.
RESOURCE2SKILL_WORKSPACE_ROOT=
# --- Local text humanizer ("Rewrite naturally") ------------------------------
# A loopback Python sidecar that rewrites the prose of an answer with a small
# local seq2seq model, behind deterministic preservation gates and an explicit
# review dialog. Entirely optional: without it the action reports that it is
# unavailable, and nothing else in Breadboard changes.
#
# Two separate opt-ins, in this order:
#   npm run setup:humanizer                        the Python environment
#   npm run setup:humanizer -- --download-model    the checkpoint
#
# The weights are a third-party download of unresolved licence status. They are
# never bundled with Breadboard — see humanizer-service/THIRD_PARTY_NOTICES.md.
#
# `local` (the default) or `disabled`. There is deliberately no remote value:
# when the local service cannot answer, the feature says so.
HUMANIZER_MODE=
# Where the service's state and the model cache live. Defaults to
# <BREADBOARD_DATA_DIR>/humanizer. Never in the checkout, never in resources.
BREADBOARD_HUMANIZER_HOME=
# Loopback port. The desktop supervisor allocates one dynamically and passes it
# through; 7735 is only the development preference.
BREADBOARD_HUMANIZER_PORT=
# Checkpoint and the reviewed revision it is pinned to. Changing either means
# re-running humanizer-service/tests and the real-model smoke test.
BREADBOARD_HUMANIZER_MODEL=
BREADBOARD_HUMANIZER_REVISION=
# Task prefix put in front of the model's input. Empty by default, and that is
# a measured choice, not an oversight: with the `humanize: ` prefix the spec
# called for, this checkpoint answers with an essay title instead of a rewrite.
# See docs/HUMANIZER_INTEGRATION.md, "What the real checkpoint taught us".
BREADBOARD_HUMANIZER_PREFIX=
# auto | cuda | cpu. `auto` uses CUDA when it is there; an explicit `cuda` on a
# machine without one fails loudly rather than silently running twenty times
# slower on the CPU.
BREADBOARD_HUMANIZER_DEVICE=
# How long the weights stay resident after the last rewrite. Default 300.
BREADBOARD_HUMANIZER_IDLE_UNLOAD_SECONDS=
# Wall-clock ceiling for one rewrite, chunks included. Default 120000.
BREADBOARD_HUMANIZER_TIMEOUT_MS=
# The loopback bearer. Leave empty: it is generated per install and kept in
# <BREADBOARD_HUMANIZER_HOME>/service-secret, or injected by the desktop
# supervisor. Never put a real secret in this file.
BREADBOARD_HUMANIZER_SECRET=
