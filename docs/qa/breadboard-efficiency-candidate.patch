+/** Open before sending headers so a file removed during lookup still uses the route's error response. */
+export async function storedFileResponse(blob: StoredFileBlob, request: Request, headers: HeadersInit) {
+  request.signal.throwIfAborted();
+  const file = await fs.promises.open(blob.path, "r");
+  try {
+    if (request.method === "HEAD") {
+      await file.close();
+      return new Response(null, { headers });
+    }
+    // The client can disconnect during open. Attaching an already-aborted signal
+    // would destroy the Node stream before the Web adapter owns its error event.
+    request.signal.throwIfAborted();
+    const chunkBytes = Math.max(1, Math.min(blob.byteSize, 512 * 1024));
+    const body = Readable.toWeb(file.createReadStream({ signal: request.signal, highWaterMark: chunkBytes }), {
+      strategy: { highWaterMark: chunkBytes, size: chunk => chunk.byteLength },
+    }) as ReadableStream<Uint8Array>;
+    return new Response(body, { headers });
+  } catch (error) {
+    await file.close();
+    throw error;
+  }
+}
+
+/** The preview decodes exactly the first 2 MiB, even when the last character is split. */
+export async function storedFileTextPreview(blob: StoredFileBlob) {
+  const limit = 2 * 1024 * 1024;
+  const file = await fs.promises.open(blob.path, "r");
+  try {
+    const buffer = Buffer.allocUnsafe(Math.min(blob.byteSize, limit));
+    let end = 0;
+    while (end < buffer.length) {
+      const { bytesRead } = await file.read(buffer, end, buffer.length - end, end);
+      if (!bytesRead) break;
+      end += bytesRead;
+    }
+    return { text: new TextDecoder().decode(buffer.subarray(0, end)), truncated: blob.byteSize > limit };
+  } finally {
+    await file.close();
+  }
+}
