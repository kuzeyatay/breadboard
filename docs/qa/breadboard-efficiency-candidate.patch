index 0000000000000000000000000000000000000000..bdbb5e7c5f5dfb19a1d79c6becd8a2ed75d6847b
--- /dev/null
+++ b/dashboard/tests/stored-file-streams.test.mjs
@@ -0,0 +1,141 @@
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import test from "node:test";
+import ts from "typescript";
+import { findStoredFileBlob, storedFileResponse, storedFileTextPreview, writeStoredFileBlob } from "../src/lib/conversations/stored-file-blob-store.ts";
+import { isMarkedWebBlob, markWebPdfBlob, touchWebPdfBlob } from "../src/lib/conversations/document-blob-store.ts";
+import { openedImageMimeType } from "../src/lib/local-document.ts";
+import { storedFileIsText } from "../src/lib/stored-file-attachments.ts";
+
+function fixture(t) {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), "bb-stored-stream-"));
+  t.after(() => fs.rmSync(root, { recursive: true, force: true }));
+  function write(format, ...chunks) {
+    return writeStoredFileBlob({ root, userId: 1, format, body: new ReadableStream({
+      start(controller) {
+        for (const chunk of chunks) controller.enqueue(chunk);
+        controller.close();
+      },
+    }) });
+  }
+  return { root, write };
+}
+
+test("upload validation preserves split signatures, UTF-8 boundaries and error precedence", async t => {
+  const { root, write } = fixture(t);
+  for (const format of ["zip", "mlx"]) {
+    const blob = await write(format, Buffer.from("P"), Buffer.from("Kbytes"));
+    assert.equal(fs.readFileSync(blob.path, "utf8"), "PKbytes");
+    assert.equal(findStoredFileBlob({ root, userId: 2, blobId: blob.blobId }), null);
+    await assert.rejects(write(format, Buffer.from("P")), { status: 415, code: "file_signature_invalid" });
+  }
+  const prefix = Buffer.alloc(64 * 1024 - 1, 97);
+  const euro = Buffer.from("€");
+  const text = await write("txt", Buffer.concat([prefix, euro.subarray(0, 2)]), euro.subarray(2));
+  assert.deepEqual(fs.readFileSync(text.path), Buffer.concat([prefix, euro]));
+  await assert.rejects(write("txt", euro.subarray(0, 2)), { code: "file_not_utf8" });
+  await assert.rejects(write("txt", Buffer.from([255]), Buffer.from([0])), { code: "file_not_text" });
+  await assert.rejects(write("txt", Buffer.from([0]), Buffer.alloc(16 * 1024 * 1024)), { code: "text_file_too_large" });
+  await assert.rejects(write("zip"), { code: "file_empty" });
+  let reads = 0;
+  const interrupted = new ReadableStream({ pull(controller) {
+    if (reads++ === 0) controller.enqueue(Buffer.from([255]));
+    else controller.error(new Error("disconnected"));
+  } });
+  await assert.rejects(writeStoredFileBlob({ root, userId: 1, format: "txt", body: interrupted }), { code: "file_upload_interrupted" });
+  assert.ok(fs.readdirSync(path.join(root, "u1")).every(name => !name.endsWith(".part")));
+});
+
+test("previews preserve truncation, original downloads and cancellation", async t => {
+  const { write } = fixture(t);
+  const limit = 2 * 1024 * 1024;
+  const bytes = Buffer.concat([Buffer.alloc(limit - 1, 65), Buffer.from("€tail")]);
+  const blob = await write("txt", bytes);
+  const open = fs.promises.open.bind(fs.promises);
+  const reads = [];
+  const closed = [];
+  let abortOnOpen;
+  t.mock.method(fs.promises, "open", async (...args) => {
+    const file = await open(...args);
+    closed.push(new Promise(resolve => file.once("close", resolve)));
+    abortOnOpen?.abort();
+    const read = file.read.bind(file);
+    file.read = async (...args) => {
+      const result = await read(...args);
+      reads.push(result.bytesRead);
+      return result;
+    };
+    return file;
+  });
+  const headers = { "content-type": "application/octet-stream", "x-content-type-options": "nosniff" };
+  const request = new Request("http://localhost/file", { headers: { Range: "bytes=1-9" } });
+  assert.deepEqual(await storedFileTextPreview(blob), { text: new TextDecoder().decode(bytes.subarray(0, limit)), truncated: true });
+  assert.equal(reads.reduce((sum, length) => sum + length, 0), limit);
+  const full = await storedFileResponse(blob, request, headers);
+  assert.equal(full.status, 200);
+  assert.equal(full.headers.get("x-content-type-options"), "nosniff");
+  assert.deepEqual(Buffer.from(await full.arrayBuffer()), bytes);
+  assert.equal((await storedFileResponse(blob, new Request(request, { method: "HEAD" }), headers)).body, null);
+  const partial = await storedFileResponse(blob, request, headers);
+  const reader = partial.body.getReader();
+  assert.ok((await reader.read()).value.byteLength <= 512 * 1024);
+  await reader.cancel();
+  const abort = new AbortController();
+  const interrupted = await storedFileResponse(blob, new Request(request, { signal: abort.signal }), headers);
+  abort.abort();
+  await assert.rejects(interrupted.arrayBuffer(), { name: "AbortError" });
+  await assert.rejects(storedFileResponse(blob, new Request(request, { signal: abort.signal }), headers), { name: "AbortError" });
+  abortOnOpen = new AbortController();
+  await assert.rejects(storedFileResponse(blob, new Request(request, { signal: abortOnOpen.signal }), headers), { name: "AbortError" });
+  abortOnOpen = undefined;
+  for (let i = 0; i < 100; i++) {
+    const opened = await storedFileResponse(blob, request, headers);
+    await opened.body.cancel();
+  }
+  await Promise.all(closed);
+});
+
+test("the image and download routes serve only the owner's original with their existing headers", async t => {
+  const { root, write } = fixture(t);
+  let userId = 1;
+  const modules = {
+    "next/server": { NextResponse: Response },
+    "@/lib/server-auth": { requireUserId: async () => userId },
+    "@/lib/hermes/route-helpers.ts": { apiErrorResponse: error => { throw error; } },
+    "@/lib/stored-file-attachments.ts": { storedFileIsText },
+    "@/lib/conversations/stored-file-blob-store.ts": {
+      findStoredFileBlob: input => findStoredFileBlob({ ...input, root }), storedFileResponse, storedFileTextPreview,
+    },
+    "@/lib/conversations/document-blob-store.ts": { isMarkedWebBlob, touchWebPdfBlob },
+    "@/lib/local-document.ts": { openedImageMimeType },
+    "@/lib/conversations/stored-file-uploads.ts": {}, "@/lib/conversations/opened-files.ts": {},
+  };
+  function get(route) {
+    const source = fs.readFileSync(new URL(`../src/app/api/chat-attachments/files/${route}`, import.meta.url), "utf8");
+    const { outputText } = ts.transpileModule(source, { compilerOptions: { module: ts.ModuleKind.CommonJS, target: ts.ScriptTarget.ES2022 } });
+    const exports = {};
+    new Function("require", "exports", outputText)(id => { assert.ok(id in modules, id); return modules[id]; }, exports);
+    return exports.GET;
+  }
+  const image = get("route.ts"), view = get("[blobId]/view/route.ts");
+  const bytes = Buffer.from([0, 1, 2, 255]);
+  const blob = await write("bin", bytes);
+  const openImage = name => image(new Request(`http://localhost/files?blobId=${blob.blobId}&name=${name}`));
+  const download = () => view(new Request("http://localhost/view?download=1"), { params: Promise.resolve(blob) });
+  assert.equal((await openImage("test.png")).status, 404);
+  markWebPdfBlob(blob);
+  assert.equal((await openImage("test.html")).status, 404);
+  const opened = await openImage("test.png");
+  assert.equal(opened.headers.get("content-type"), "image/png");
+  assert.equal(opened.headers.get("cache-control"), "private, max-age=3600");
+  assert.equal(opened.headers.get("x-content-type-options"), "nosniff");
+  assert.deepEqual(Buffer.from(await opened.arrayBuffer()), bytes);
+  const original = await download();
+  assert.equal(original.headers.get("content-disposition"), `attachment; filename="${blob.blobId}.bin"`);
+  assert.deepEqual(Buffer.from(await original.arrayBuffer()), bytes);
+  userId = 2;
+  assert.equal((await openImage("test.png")).status, 404);
+  assert.equal((await download()).status, 404);
+});
