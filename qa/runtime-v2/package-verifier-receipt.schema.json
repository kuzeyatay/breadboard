{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://breadboard.local/schemas/runtime-v2/package-verifier-receipt.schema.json",
  "title": "Breadboard Runtime V2 package verifier receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "runId",
    "startedAt",
    "finishedAt",
    "recordedAt",
    "package",
    "verifier",
    "sourceAuthority",
    "contentSha256"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "breadboard-runtime-v2-package-verifier-receipt" },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "startedAt": { "$ref": "#/$defs/timestamp" },
    "finishedAt": { "$ref": "#/$defs/timestamp" },
    "recordedAt": { "$ref": "#/$defs/timestamp" },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rootName",
        "rootPath",
        "rootPathSha256",
        "closure",
        "criticalArtifacts",
        "criticalArtifactsSha256"
      ],
      "properties": {
        "rootName": { "const": "win-unpacked" },
        "rootPath": { "type": "string", "minLength": 1 },
        "rootPathSha256": { "$ref": "#/$defs/sha256" },
        "closure": { "$ref": "#/$defs/packageClosure" },
        "criticalArtifacts": { "$ref": "#/$defs/criticalArtifacts" },
        "criticalArtifactsSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "verifier": { "$ref": "#/$defs/verifier" },
    "sourceAuthority": { "$ref": "#/$defs/sourceAuthority" },
    "contentSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9A-F]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "fileReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "$ref": "#/$defs/positiveInteger" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "executableReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "pathSha256", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "pathSha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "$ref": "#/$defs/positiveInteger" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "packageClosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "directoryCount",
        "fileCount",
        "totalBytes",
        "sha256"
      ],
      "properties": {
        "algorithm": { "const": "breadboard-package-tree-sha256-v1" },
        "directoryCount": { "$ref": "#/$defs/nonNegativeInteger" },
        "fileCount": { "$ref": "#/$defs/positiveInteger" },
        "totalBytes": { "$ref": "#/$defs/positiveInteger" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "criticalArtifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "breadboardExecutable",
        "appAsar",
        "runtimeServicesManifest",
        "runtimeWorkersManifest",
        "dashboardRuntimeEntrypoint",
        "bundledNode",
        "bundledBun",
        "bundledPython",
        "codex",
        "runtimeSupervisor",
        "breadboardRuntime"
      ],
      "properties": {
        "breadboardExecutable": {
          "allOf": [
            { "$ref": "#/$defs/executableReference" },
            { "properties": { "path": { "const": "Breadboard.exe" } } }
          ]
        },
        "appAsar": {
          "allOf": [
            { "$ref": "#/$defs/fileReference" },
            { "properties": { "path": { "const": "resources/app.asar" } } }
          ]
        },
        "runtimeServicesManifest": {
          "allOf": [
            { "$ref": "#/$defs/fileReference" },
            {
              "properties": {
                "path": { "const": "resources/runtime-v2/manifests/services.json" }
              }
            }
          ]
        },
        "runtimeWorkersManifest": {
          "allOf": [
            { "$ref": "#/$defs/fileReference" },
            {
              "properties": {
                "path": { "const": "resources/runtime-v2/manifests/workers.json" }
              }
            }
          ]
        },
        "dashboardRuntimeEntrypoint": {
          "allOf": [
            { "$ref": "#/$defs/fileReference" },
            {
              "properties": {
                "path": {
                  "const": "resources/app-services/dashboard/scripts/runtime-v2-dashboard.mjs"
                }
              }
            }
          ]
        },
        "bundledNode": {
          "allOf": [
            { "$ref": "#/$defs/fileReference" },
            {
              "properties": { "path": { "const": "resources/runtimes/node/node.exe" } }
            }
          ]
        },
        "bundledBun": {
          "allOf": [
            { "$ref": "#/$defs/fileReference" },
            {
              "properties": { "path": { "const": "resources/runtimes/bun/bun.exe" } }
            }
          ]
        },
        "bundledPython": {
          "allOf": [
            { "$ref": "#/$defs/fileReference" },
            {
              "properties": { "path": { "const": "resources/runtimes/python/python.exe" } }
            }
          ]
        },
        "codex": {
          "allOf": [
            { "$ref": "#/$defs/fileReference" },
            { "properties": { "path": { "const": "resources/bin/codex.exe" } } }
          ]
        },
        "runtimeSupervisor": {
          "allOf": [
            { "$ref": "#/$defs/fileReference" },
            {
              "properties": { "path": { "const": "resources/bin/runtime-supervisor.exe" } }
            }
          ]
        },
        "breadboardRuntime": {
          "allOf": [
            { "$ref": "#/$defs/fileReference" },
            {
              "properties": { "path": { "const": "resources/bin/breadboard-runtime.exe" } }
            }
          ]
        }
      }
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "exitCode",
        "okLine",
        "okLineCount",
        "stdout",
        "stderr",
        "stdoutBytes",
        "stderrBytes",
        "stdoutSha256",
        "stderrSha256"
      ],
      "properties": {
        "path": { "const": "desktop/scripts/verify-package.mjs" },
        "exitCode": { "const": 0 },
        "okLine": { "const": "[verify-package] OK" },
        "okLineCount": { "const": 1 },
        "stdout": { "type": "string", "maxLength": 16777216 },
        "stderr": { "type": "string", "maxLength": 16777216 },
        "stdoutBytes": { "$ref": "#/$defs/nonNegativeInteger" },
        "stderrBytes": { "$ref": "#/$defs/nonNegativeInteger" },
        "stdoutSha256": { "$ref": "#/$defs/sha256" },
        "stderrSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "sourceFileSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "fileCount", "totalBytes", "sha256", "files"],
      "properties": {
        "algorithm": { "const": "breadboard-source-file-set-sha256-v1" },
        "fileCount": { "$ref": "#/$defs/positiveInteger" },
        "totalBytes": { "$ref": "#/$defs/positiveInteger" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/fileReference" }
        }
      }
    },
    "sourceAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verifierImportClosure", "policyInputs", "sha256"],
      "properties": {
        "verifierImportClosure": { "$ref": "#/$defs/sourceFileSet" },
        "policyInputs": {
          "allOf": [
            { "$ref": "#/$defs/sourceFileSet" },
            { "properties": { "fileCount": { "const": 3 }, "files": { "minItems": 3, "maxItems": 3 } } }
          ]
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
