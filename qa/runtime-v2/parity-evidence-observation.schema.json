{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://breadboard.local/schemas/runtime-v2-parity-observation-v1.json",
  "title": "Breadboard Runtime V2 runner-emitted parity observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "runId",
    "capabilityId",
    "evidenceType",
    "result",
    "executionDisposition",
    "fallbackUsed",
    "runtimeMode",
    "workflowIdentity",
    "operationId",
    "producer",
    "executable",
    "packageVerification",
    "timestamps",
    "claims",
    "supportingArtifacts",
    "contentSha256"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "breadboard-runtime-v2-parity-observation" },
    "runId": { "$ref": "#/$defs/runId" },
    "capabilityId": { "$ref": "#/$defs/boundedId" },
    "evidenceType": {
      "enum": ["electron", "service", "worker", "output", "cancellation", "recovery"]
    },
    "result": { "enum": ["PASS", "BLOCKED", "FAIL"] },
    "executionDisposition": {
      "enum": [
        "REAL_WORKFLOW_COMPLETED",
        "MATCHING_BASELINE_PREREQUISITE_BLOCKED",
        "REAL_WORKFLOW_FAILED"
      ]
    },
    "fallbackUsed": { "const": false },
    "runtimeMode": { "const": "packaged-electron" },
    "workflowIdentity": { "$ref": "#/$defs/workflowIdentity" },
    "operationId": { "$ref": "#/$defs/boundedId" },
    "producer": { "$ref": "#/$defs/producer" },
    "executable": { "$ref": "#/$defs/executable" },
    "packageVerification": { "$ref": "#/$defs/packageVerification" },
    "timestamps": { "$ref": "#/$defs/timestamps" },
    "claims": { "type": "object" },
    "supportingArtifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/fileReference" }
    },
    "blocker": { "$ref": "#/$defs/blocker" },
    "failureCode": { "$ref": "#/$defs/code" },
    "failureSummary": { "$ref": "#/$defs/summary" },
    "contentSha256": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [
    {
      "if": { "properties": { "result": { "const": "PASS" } }, "required": ["result"] },
      "then": {
        "properties": { "executionDisposition": { "const": "REAL_WORKFLOW_COMPLETED" } },
        "not": { "anyOf": [{ "required": ["blocker"] }, { "required": ["failureCode"] }, { "required": ["failureSummary"] }] }
      }
    },
    {
      "if": { "properties": { "result": { "const": "BLOCKED" } }, "required": ["result"] },
      "then": {
        "required": ["blocker"],
        "properties": { "executionDisposition": { "const": "MATCHING_BASELINE_PREREQUISITE_BLOCKED" } },
        "not": { "anyOf": [{ "required": ["failureCode"] }, { "required": ["failureSummary"] }] }
      }
    },
    {
      "if": { "properties": { "result": { "const": "FAIL" } }, "required": ["result"] },
      "then": {
        "required": ["failureCode", "failureSummary"],
        "properties": {
          "evidenceType": { "const": "electron" },
          "executionDisposition": { "const": "REAL_WORKFLOW_FAILED" }
        },
        "not": { "required": ["blocker"] }
      }
    },
    { "$ref": "#/$defs/claimConditionPassElectron" },
    { "$ref": "#/$defs/claimConditionPassService" },
    { "$ref": "#/$defs/claimConditionPassWorker" },
    { "$ref": "#/$defs/claimConditionPassOutput" },
    { "$ref": "#/$defs/claimConditionPassCancellation" },
    { "$ref": "#/$defs/claimConditionPassRecovery" },
    { "$ref": "#/$defs/claimConditionBlockedElectron" },
    { "$ref": "#/$defs/claimConditionBlockedService" },
    { "$ref": "#/$defs/claimConditionBlockedWorker" },
    { "$ref": "#/$defs/claimConditionBlockedOutput" },
    { "$ref": "#/$defs/claimConditionBlockedCancellation" },
    { "$ref": "#/$defs/claimConditionBlockedRecovery" },
    { "$ref": "#/$defs/claimConditionFailureElectron" }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "boundedId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,255}$"
    },
    "code": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9_-]{0,127}$"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?:[^\\s\\u0000]|[^\\s\\u0000][^\\r\\n\\u0000]*[^\\s\\u0000])$"
    },
    "boundedText500": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?:[^\\s\\u0000]|[^\\s\\u0000][^\\r\\n\\u0000]*[^\\s\\u0000])$"
    },
    "canonicalIso": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "workflowIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["electronRunId", "workflowId", "conversationIdSha256"],
      "properties": {
        "electronRunId": { "$ref": "#/$defs/runId" },
        "workflowId": { "$ref": "#/$defs/boundedId" },
        "conversationIdSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 1024,
          "pattern": "^qa/electron/specs/(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)(?:[A-Za-z0-9._-]+/)*[A-Za-z0-9._-]+\\.spec\\.ts$"
        },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 2097152 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "executable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "pathSha256", "bytes", "sha256"],
      "properties": {
        "fileName": { "const": "Breadboard.exe" },
        "pathSha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "packageVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt",
        "packageRootPathSha256",
        "closureSha256",
        "closureFileCount",
        "closureBytes",
        "verifierSourceClosureSha256"
      ],
      "properties": {
        "receipt": { "$ref": "#/$defs/fileReference" },
        "packageRootPathSha256": { "$ref": "#/$defs/sha256" },
        "closureSha256": { "$ref": "#/$defs/sha256" },
        "closureFileCount": { "type": "integer", "minimum": 1 },
        "closureBytes": { "type": "integer", "minimum": 1 },
        "verifierSourceClosureSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "timestamps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startedAt", "finishedAt", "recordedAt"],
      "properties": {
        "startedAt": { "$ref": "#/$defs/canonicalIso" },
        "finishedAt": { "$ref": "#/$defs/canonicalIso" },
        "recordedAt": { "$ref": "#/$defs/canonicalIso" }
      }
    },
    "fileReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "capturedAt"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?:\\.qa-results|qa/runtime-v2/evidence)/(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)[^\\\\#]+$"
        },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "capturedAt": { "$ref": "#/$defs/canonicalIso" }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prerequisiteType", "prerequisiteId", "code", "summary"],
      "properties": {
        "prerequisiteType": {
          "enum": ["CREDENTIAL", "MODEL_FILE", "EXTERNAL_SERVICE", "EXTERNAL_SOFTWARE"]
        },
        "prerequisiteId": { "$ref": "#/$defs/boundedId" },
        "code": { "$ref": "#/$defs/code" },
        "summary": { "$ref": "#/$defs/summary" }
      }
    },
    "notApplicableService": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicability", "inventoryContractObserved", "noServiceExpected"],
      "properties": {
        "applicability": { "const": "NOT_APPLICABLE" },
        "inventoryContractObserved": { "const": true },
        "noServiceExpected": { "const": true }
      }
    },
    "notApplicableWorker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicability", "inventoryContractObserved", "noWorkerExpected"],
      "properties": {
        "applicability": { "const": "NOT_APPLICABLE" },
        "inventoryContractObserved": { "const": true },
        "noWorkerExpected": { "const": true }
      }
    },
    "notApplicableOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicability", "inventoryContractObserved", "noOutputExpected"],
      "properties": {
        "applicability": { "const": "NOT_APPLICABLE" },
        "inventoryContractObserved": { "const": true },
        "noOutputExpected": { "const": true }
      }
    },
    "notApplicableCancellation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicability", "inventoryContractObserved", "cancellationNotSupported"],
      "properties": {
        "applicability": { "const": "NOT_APPLICABLE" },
        "inventoryContractObserved": { "const": true },
        "cancellationNotSupported": { "const": true }
      }
    },
    "notApplicableRecovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicability", "inventoryContractObserved", "recoveryNotSupported", "reasonCode", "sourceProvenPreMigrationSemantics"],
      "properties": {
        "applicability": { "const": "NOT_APPLICABLE" },
        "inventoryContractObserved": { "const": true },
        "recoveryNotSupported": { "const": true },
        "reasonCode": { "$ref": "#/$defs/boundedId" },
        "sourceProvenPreMigrationSemantics": { "const": true }
      }
    },
    "passFollowUpClaims": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["applicability", "sameConversationObserved", "priorContextObserved"],
          "properties": {
            "applicability": { "const": "APPLICABLE" },
            "sameConversationObserved": { "const": true },
            "priorContextObserved": { "const": true }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["applicability", "inventoryContractObserved", "followUpNotSupported"],
          "properties": {
            "applicability": { "const": "NOT_APPLICABLE" },
            "inventoryContractObserved": { "const": true },
            "followUpNotSupported": { "const": true }
          }
        }
      ]
    },
    "passElectronClaims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uiEntryPoint", "selectedCapabilityId", "normalEntryPointUsed", "realRequestSubmitted", "selectionObserved", "semanticAssertionsPassed"],
      "properties": {
        "uiEntryPoint": { "$ref": "#/$defs/boundedText500" },
        "selectedCapabilityId": { "$ref": "#/$defs/boundedId" },
        "normalEntryPointUsed": { "const": true },
        "realRequestSubmitted": { "const": true },
        "selectionObserved": { "const": true },
        "semanticAssertionsPassed": { "const": true },
        "followUp": { "$ref": "#/$defs/passFollowUpClaims" }
      }
    },
    "passServiceClaims": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["applicability", "serviceId", "runtimeOwned", "startOrLeaseObserved", "singleInstanceObserved", "readyObserved"],
          "properties": {
            "applicability": { "const": "APPLICABLE" },
            "serviceId": { "$ref": "#/$defs/boundedId" },
            "runtimeOwned": { "const": true },
            "startOrLeaseObserved": { "const": true },
            "singleInstanceObserved": { "const": true },
            "readyObserved": { "const": true }
          }
        },
        { "$ref": "#/$defs/notApplicableService" }
      ]
    },
    "passWorkerClaims": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["applicability", "workerKind", "jobIdSha256", "workerInstanceIdSha256", "freshProcessObserved", "terminalExitObserved", "descendantsCleaned"],
          "properties": {
            "applicability": { "const": "APPLICABLE" },
            "workerKind": { "$ref": "#/$defs/boundedId" },
            "jobIdSha256": { "$ref": "#/$defs/sha256" },
            "workerInstanceIdSha256": { "$ref": "#/$defs/sha256" },
            "freshProcessObserved": { "const": true },
            "terminalExitObserved": { "const": true },
            "descendantsCleaned": { "const": true }
          }
        },
        { "$ref": "#/$defs/notApplicableWorker" }
      ]
    },
    "passOutputClaims": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["applicability", "outputKind", "outputIdSha256", "expectedOutputObserved", "nonPlaceholderObserved", "openBehaviorObserved"],
          "properties": {
            "applicability": { "const": "APPLICABLE" },
            "outputKind": { "$ref": "#/$defs/boundedId" },
            "outputIdSha256": { "$ref": "#/$defs/sha256" },
            "expectedOutputObserved": { "const": true },
            "nonPlaceholderObserved": { "const": true },
            "openBehaviorObserved": { "const": true }
          }
        },
        { "$ref": "#/$defs/notApplicableOutput" }
      ]
    },
    "passCancellationClaims": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["applicability", "cancellationRequested", "terminalCancellationObserved", "visibleResultObserved", "descendantsCleaned"],
          "properties": {
            "applicability": { "const": "APPLICABLE" },
            "cancellationRequested": { "const": true },
            "terminalCancellationObserved": { "const": true },
            "visibleResultObserved": { "const": true },
            "descendantsCleaned": { "const": true }
          }
        },
        { "$ref": "#/$defs/notApplicableCancellation" }
      ]
    },
    "passRecoveryClaims": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["applicability", "recoveryKind", "reconnected", "noDuplicationObserved", "contextPreserved"],
          "properties": {
            "applicability": { "const": "APPLICABLE" },
            "recoveryKind": { "enum": ["REFRESH", "DASHBOARD_RESTART", "APP_RESTART"] },
            "reconnected": { "const": true },
            "noDuplicationObserved": { "const": true },
            "contextPreserved": { "const": true }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "applicability",
            "recoveryKind",
            "selectedIdentitySha256",
            "unresolvableSelectionInjected",
            "truthfulFailurePresentationObserved",
            "selectionCleared",
            "noFallbackObserved",
            "sourceContextRestored",
            "sameConversationObserved",
            "priorContextObserved",
            "noDuplicationObserved"
          ],
          "properties": {
            "applicability": { "const": "APPLICABLE" },
            "recoveryKind": { "const": "SOURCE_SELECTION_FAIL_CLOSED" },
            "selectedIdentitySha256": { "$ref": "#/$defs/sha256" },
            "unresolvableSelectionInjected": { "const": true },
            "truthfulFailurePresentationObserved": { "const": true },
            "selectionCleared": { "const": true },
            "noFallbackObserved": { "const": true },
            "sourceContextRestored": { "const": true },
            "sameConversationObserved": { "const": true },
            "priorContextObserved": { "const": true },
            "noDuplicationObserved": { "const": true }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "applicability",
            "recoveryKind",
            "selectedIdentitySha256",
            "appRestartObserved",
            "storedSelectionRestored",
            "postRestartRequestUsedSelection",
            "sameConversationObserved",
            "priorContextObserved",
            "noDuplicationObserved",
            "contextPreserved"
          ],
          "properties": {
            "applicability": { "const": "APPLICABLE" },
            "recoveryKind": { "const": "STORED_SELECTION_APP_RESTART" },
            "selectedIdentitySha256": { "$ref": "#/$defs/sha256" },
            "appRestartObserved": { "const": true },
            "storedSelectionRestored": { "const": true },
            "postRestartRequestUsedSelection": { "const": true },
            "sameConversationObserved": { "const": true },
            "priorContextObserved": { "const": true },
            "noDuplicationObserved": { "const": true },
            "contextPreserved": { "const": true }
          }
        },
        { "$ref": "#/$defs/notApplicableRecovery" }
      ]
    },
    "blockedElectronClaims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uiEntryPoint", "selectedCapabilityId", "normalEntryPointUsed", "realRequestSubmitted", "selectionObserved", "truthfulBlockedPresentationObserved"],
      "properties": {
        "uiEntryPoint": { "$ref": "#/$defs/boundedText500" },
        "selectedCapabilityId": { "$ref": "#/$defs/boundedId" },
        "normalEntryPointUsed": { "const": true },
        "realRequestSubmitted": { "const": true },
        "selectionObserved": { "const": true },
        "truthfulBlockedPresentationObserved": { "const": true }
      }
    },
    "blockedServiceClaims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredRuntimeId", "runtimeBoundaryObserved", "unrelatedServicesUnaffected", "noFallbackObserved"],
      "properties": {
        "requiredRuntimeId": { "$ref": "#/$defs/boundedId" },
        "runtimeBoundaryObserved": { "const": true },
        "unrelatedServicesUnaffected": { "const": true },
        "noFallbackObserved": { "const": true }
      }
    },
    "blockedWorkerClaims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedWorkerKind", "dispatchBoundaryObserved", "orphanCount", "noFallbackObserved"],
      "properties": {
        "expectedWorkerKind": { "$ref": "#/$defs/boundedId" },
        "dispatchBoundaryObserved": { "const": true },
        "orphanCount": { "const": 0 },
        "noFallbackObserved": { "const": true }
      }
    },
    "blockedOutputClaims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedOutputKind", "placeholderAbsent", "truthfulBlockedResultObserved"],
      "properties": {
        "expectedOutputKind": { "$ref": "#/$defs/boundedId" },
        "placeholderAbsent": { "const": true },
        "truthfulBlockedResultObserved": { "const": true }
      }
    },
    "blockedCancellationClaims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cancellationContractObserved", "orphanCount", "noFallbackObserved"],
      "properties": {
        "cancellationContractObserved": { "const": true },
        "orphanCount": { "const": 0 },
        "noFallbackObserved": { "const": true }
      }
    },
    "blockedRecoveryClaims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recoveryContractObserved", "noDuplicationObserved", "truthfulBlockedStateRetained"],
      "properties": {
        "recoveryContractObserved": { "const": true },
        "noDuplicationObserved": { "const": true },
        "truthfulBlockedStateRetained": { "const": true }
      }
    },
    "failureElectronClaims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uiEntryPoint", "selectedCapabilityId", "normalEntryPointUsed", "realRequestSubmitted", "selectionObserved", "failureObserved", "truthfulFailurePresentationObserved"],
      "properties": {
        "uiEntryPoint": { "$ref": "#/$defs/boundedText500" },
        "selectedCapabilityId": { "$ref": "#/$defs/boundedId" },
        "normalEntryPointUsed": { "const": true },
        "realRequestSubmitted": { "const": true },
        "selectionObserved": { "const": true },
        "failureObserved": { "const": true },
        "truthfulFailurePresentationObserved": { "const": true }
      }
    },
    "claimConditionPassElectron": {
      "if": { "properties": { "result": { "const": "PASS" }, "evidenceType": { "const": "electron" } }, "required": ["result", "evidenceType"] },
      "then": { "properties": { "claims": { "$ref": "#/$defs/passElectronClaims" } } }
    },
    "claimConditionPassService": {
      "if": { "properties": { "result": { "const": "PASS" }, "evidenceType": { "const": "service" } }, "required": ["result", "evidenceType"] },
      "then": { "properties": { "claims": { "$ref": "#/$defs/passServiceClaims" } } }
    },
    "claimConditionPassWorker": {
      "if": { "properties": { "result": { "const": "PASS" }, "evidenceType": { "const": "worker" } }, "required": ["result", "evidenceType"] },
      "then": { "properties": { "claims": { "$ref": "#/$defs/passWorkerClaims" } } }
    },
    "claimConditionPassOutput": {
      "if": { "properties": { "result": { "const": "PASS" }, "evidenceType": { "const": "output" } }, "required": ["result", "evidenceType"] },
      "then": { "properties": { "claims": { "$ref": "#/$defs/passOutputClaims" } } }
    },
    "claimConditionPassCancellation": {
      "if": { "properties": { "result": { "const": "PASS" }, "evidenceType": { "const": "cancellation" } }, "required": ["result", "evidenceType"] },
      "then": { "properties": { "claims": { "$ref": "#/$defs/passCancellationClaims" } } }
    },
    "claimConditionPassRecovery": {
      "if": { "properties": { "result": { "const": "PASS" }, "evidenceType": { "const": "recovery" } }, "required": ["result", "evidenceType"] },
      "then": { "properties": { "claims": { "$ref": "#/$defs/passRecoveryClaims" } } }
    },
    "claimConditionBlockedElectron": {
      "if": { "properties": { "result": { "const": "BLOCKED" }, "evidenceType": { "const": "electron" } }, "required": ["result", "evidenceType"] },
      "then": { "properties": { "claims": { "$ref": "#/$defs/blockedElectronClaims" } } }
    },
    "claimConditionBlockedService": {
      "if": { "properties": { "result": { "const": "BLOCKED" }, "evidenceType": { "const": "service" } }, "required": ["result", "evidenceType"] },
      "then": { "properties": { "claims": { "$ref": "#/$defs/blockedServiceClaims" } } }
    },
    "claimConditionBlockedWorker": {
      "if": { "properties": { "result": { "const": "BLOCKED" }, "evidenceType": { "const": "worker" } }, "required": ["result", "evidenceType"] },
      "then": { "properties": { "claims": { "$ref": "#/$defs/blockedWorkerClaims" } } }
    },
    "claimConditionBlockedOutput": {
      "if": { "properties": { "result": { "const": "BLOCKED" }, "evidenceType": { "const": "output" } }, "required": ["result", "evidenceType"] },
      "then": { "properties": { "claims": { "$ref": "#/$defs/blockedOutputClaims" } } }
    },
    "claimConditionBlockedCancellation": {
      "if": { "properties": { "result": { "const": "BLOCKED" }, "evidenceType": { "const": "cancellation" } }, "required": ["result", "evidenceType"] },
      "then": { "properties": { "claims": { "$ref": "#/$defs/blockedCancellationClaims" } } }
    },
    "claimConditionBlockedRecovery": {
      "if": { "properties": { "result": { "const": "BLOCKED" }, "evidenceType": { "const": "recovery" } }, "required": ["result", "evidenceType"] },
      "then": { "properties": { "claims": { "$ref": "#/$defs/blockedRecoveryClaims" } } }
    },
    "claimConditionFailureElectron": {
      "if": { "properties": { "result": { "const": "FAIL" } }, "required": ["result"] },
      "then": { "properties": { "claims": { "$ref": "#/$defs/failureElectronClaims" } } }
    }
  }
}
