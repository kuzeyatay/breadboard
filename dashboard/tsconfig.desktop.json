{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next-desktop/types/**/*.ts",
    ".next-desktop/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "scripts",
    "tests",
    "src/vendor/genoffice/pptx-render/src/bidi-js.d.ts",
    "src/vendor/genoffice/docs/src/renderer/ai",
    "src/vendor-overrides",
    ".next/**",
    ".next-dev/**",
    ".next-production/**"
  ]
}
