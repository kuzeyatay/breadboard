# Breadboard dashboard environment (copy to .env.local and fill in).

# --- Existing generation pipeline (ChatMock / OpenAI-compatible) ------------
OPENAI_BASE_URL=http://localhost:8765/v1
OPENAI_API_KEY=local
CHATMOCK_BASE_URL=http://127.0.0.1:8765/v1
CHATMOCK_MODEL=gpt-5.6-sol
NEXTAUTH_SECRET=change-me
NEXTAUTH_URL=http://localhost:3000
QUARTZ_CONTENT_PATH=../quartz/content
NEXT_PUBLIC_QUARTZ_URL=http://localhost:8081

# --- OpenHarness interactive agent runtime ---------------------------------
# A clean checkout is OpenHarness-first. `required` never falls back,
# `preferred` permits only an explicit visible fallback, and `legacy`
# intentionally uses the previous direct ChatMock transport. The enabled flag
# remains a compatibility kill switch; false implies legacy when mode is unset.
OPENHARNESS_ENABLED=true
OPENHARNESS_MODE=required

# OpenHarness server (a local OpenCode fork). Bind local, protect with a password.
OPENHARNESS_BASE_URL=http://127.0.0.1:4096
OPENHARNESS_USERNAME=breadboard
OPENHARNESS_PASSWORD=breadboard-local-dev
# Absolute path used as the root for per-session workspaces. Defaults to
# <repo>/.runtime/openharness when unset.
OPENHARNESS_ROOT=
OPENHARNESS_TERMINAL_AGENT=breadboard-assistant
OPENHARNESS_GARDEN_AGENT=breadboard-garden
OPENHARNESS_QUARTZ_AGENT=breadboard-quartz
OPENHARNESS_CAPABILITY_SCOUT_AGENT=breadboard-capability-scout
OPENHARNESS_REQUEST_TIMEOUT_MS=120000

# Native OpenCode web-search provider and background specialist delegation.
OPENCODE_ENABLE_EXA=1
OPENCODE_EXPERIMENTAL_BACKGROUND_SUBAGENTS=true

# URL the OpenHarness garden/quartz tool adapter uses to call back into
# Breadboard (server-to-server, loopback). Defaults to http://127.0.0.1:3000.
BREADBOARD_INTERNAL_URL=http://127.0.0.1:3000

# Secret for signing short-lived capability tokens. Falls back to NEXTAUTH_SECRET
# when unset; set explicitly in production.
OPENHARNESS_CAPABILITY_SECRET=
# Shared only between the dashboard server and OpenHarness plugin process.
# Set a strong value outside local development; never expose it to the browser.
OPENHARNESS_TOOL_SECRET=

# Comma-separated extra origins allowed to call the public Quartz AI endpoints
# (in addition to the Quartz/dashboard defaults).
QUARTZ_AI_ALLOWED_ORIGINS=

# Skill lifecycle roots. General skills default to <repo>/.agents/skills for
# compatibility; reviewed coding skills use the separate conditional store.
OPENHARNESS_SKILLS_QUARANTINE=
OPENHARNESS_SKILLS_APPROVED=
OPENHARNESS_SKILLS_CONDITIONAL=

# Optional supported skills.sh catalog API. Without it, Breadboard uses the
# official Skills CLI, then an honest last-known cache on temporary failure.
SKILLS_CATALOG_API_URL=
SKILLS_CATALOG_API_TOKEN=

# Pinned official Skills CLI package used for real discovery and quarantine.
SKILLS_CLI_PACKAGE=skills@1.5.9

# --- Video transcription (Scriberr) ----------------------------------------
# Scriberr is a separate local service (see ./scriberr, usually run through
# Docker). Breadboard talks to it over HTTP only. NOTE: Scriberr defaults to
# port 8080, which the local Jina Reader also uses — remap Scriberr (e.g.
# "8091:8080" in docker compose, or SCRIBERR_PORT for scripts/start-scriberr)
# and point SCRIBERR_BASE_URL at the remapped port.
VIDEO_TRANSCRIPTION_ENABLED=true
SCRIBERR_BASE_URL=http://127.0.0.1:8091
# Preferred auth: an API key created in Scriberr (Settings -> API Keys).
SCRIBERR_API_TOKEN=
# Alternative auth: the Scriberr account credentials (JWT login).
SCRIBERR_USERNAME=
SCRIBERR_PASSWORD=
SCRIBERR_REQUEST_TIMEOUT_MS=30000
SCRIBERR_TRANSCRIPTION_TIMEOUT_MS=21600000
SCRIBERR_POLL_INTERVAL_MS=3000
# Transcription parameters passed to Scriberr's start endpoint.
SCRIBERR_MODEL_FAMILY=whisper
SCRIBERR_MODEL=small
SCRIBERR_LANGUAGE=
SCRIBERR_DIARIZATION=false
# Delete the Scriberr-side job (and its media) after a successful import.
VIDEO_TRANSCRIPTION_DELETE_SCRIBERR_JOBS=false

VIDEO_TRANSCRIPTION_MAX_UPLOAD_MB=2048
VIDEO_TRANSCRIPTION_MAX_DURATION_SECONDS=21600
# Job-scoped temp media directory; defaults to the OS temp dir when empty.
VIDEO_TRANSCRIPTION_TEMP_DIR=
VIDEO_TRANSCRIPTION_KEEP_MEDIA=false
VIDEO_TRANSCRIPTION_TEMP_RETENTION_HOURS=24
VIDEO_TRANSCRIPTION_MAX_CONCURRENT=1
VIDEO_TRANSCRIPTION_MAX_QUEUED_PER_GARDEN=5

# External tools (used for YouTube metadata previews and upload validation).
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
YTDLP_DOWNLOAD_TIMEOUT_MS=1800000

# --- GBrain (garden knowledge retrieval; see root .env.example) -------------
# The dashboard reads these to reach the loopback GBrain adapter. GBRAIN_MODE and
# GBRAIN_ADAPTER_SECRET are normally injected by the dev launcher (scripts/dev-all.mjs);
# set them here for a standalone dashboard against a manually-started adapter.
GBRAIN_MODE=disabled
GBRAIN_ADAPTER_URL=http://127.0.0.1:7717
GBRAIN_ADAPTER_SECRET=
GBRAIN_QUERY_TIMEOUT_MS=15000
# Absolute path to a local agency-agents checkout used by Garden Chat and Terminal.
# Required in production/desktop builds; development also checks a sibling checkout.
AGENCY_AGENTS_PATH=
