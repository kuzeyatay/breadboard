# Breadboard dashboard environment (copy to .env.local and fill in).

# --- Existing generation pipeline (ChatMock / OpenAI-compatible) ------------
OPENAI_BASE_URL=http://localhost:8765/v1
OPENAI_API_KEY=local
CHATMOCK_BASE_URL=http://127.0.0.1:8765/v1
CHATMOCK_MODEL=gpt-5.6-sol
NEXTAUTH_SECRET=change-me
NEXTAUTH_URL=http://localhost:3000
QUARTZ_CONTENT_PATH=../quartz/content
NEXT_PUBLIC_QUARTZ_URL=http://localhost:8081

# Server-only local Voicebox endpoint. The browser reaches it only through
# authenticated Breadboard speech routes; keep this bound to loopback.
VOICEBOX_BASE_URL=http://127.0.0.1:17493

# --- Music recognition -----------------------------------------------------
# Provider calls happen only from authenticated server routes. Never rename
# the credential with a NEXT_PUBLIC_ prefix or expose it to browser code.
# No key is required for the default Shazam fingerprint provider. It uses an
# unofficial endpoint and may need maintenance if Shazam changes its protocol.
MUSIC_RECOGNITION_PROVIDER=shazam
# Optional supported provider fallback: set the provider to audd and add a token.
AUDD_API_TOKEN=

# --- Hermes runtime ---------------------------------------------------------
# Hermes is the conversational runtime. Codex is launched separately from the
# Agents palette and uses ChatMock's Responses API for coding tasks.
CODEX_BIN=

# Optional override for the cloned ARIS autonomous-research skill repository.
# By default Breadboard discovers ../auto-claude-code-research-in-sleep.
ARIS_ROOT=

# --- HyperFrames video agent ------------------------------------------------
# All optional: each piece is discovered before these are consulted. The CLI is
# looked for in a built ./hyperframes clone, then Breadboard's own npm prefix
# (dashboard/hyperframes-cli), then PATH; ffmpeg in agent-reach/.tools/bin, then
# PATH; the browser among installed Chrome/Edge locations. Set one only to pin it.
HYPERFRAMES_ROOT=
HYPERFRAMES_BIN=
HYPERFRAMES_FFMPEG_PATH=
HYPERFRAMES_FFPROBE_PATH=
HYPERFRAMES_BROWSER_PATH=
# Where scaffolded video projects and their renders are kept.
HYPERFRAMES_WORKSPACE_ROOT=

# --- Vox Director explainer agent -------------------------------------------
# All optional. The clone is found next to the dashboard, Python and Pillow come
# from the machine, ffmpeg from the copies this repository already ships, the
# posters from Breadboard's ComfyUI (see COMFYUI_* below) and the narration from
# Voicebox (VOICEBOX_BASE_URL). There is no vendor key: the upstream skill's
# hosted path (api.atlascloud.ai) is not used and ATLASCLOUD_API_KEY is never read.
VOX_DIRECTOR_ROOT=
VOX_DIRECTOR_PYTHON=
# Where productions and their MP4s are kept. Never pruned; the film is the point.
VOX_DIRECTOR_WORKSPACE_ROOT=
# A folder of local music files to score a film with. Nothing is downloaded and
# nothing is generated; with no folder a film has narration and no music.
VOX_DIRECTOR_MUSIC_DIR=

# Wardrobe (/agents:wardrobe). All optional: the clone is found next to the
# dashboard, its data lives in the clone, and the model layer is ChatMock
# through a loopback bridge rather than a vendor key.
WARDROBE_ROOT=
WARDROBE_DATA_DIR=
WARDROBE_MODEL_REFERENCE=

# --- Classroom (OpenMAIC) ----------------------------------------------------
# /agents:classroom runs a Breadboard-owned copy of the OpenMAIC clone as a local
# Next.js server on ChatMock. Setup (from the agent's settings) copies openmaic/
# into <data>/runtime-v2/toolchains/openmaic, installs and builds it there; the
# clone itself is never run from or written to. Override the locations here.
OPENMAIC_ROOT=
OPENMAIC_RUNTIME_ROOT=
OPENMAIC_DATA_DIR=

# --- Connected apps ---------------------------------------------------------
# Active broker: Composio managed connections. Create a Composio project API key;
# users then click Connect and authorize accounts through hosted Connect Links.
COMPOSIO_API_KEY=
# Optional namespace for external user IDs inside a shared Composio project.
COMPOSIO_USER_ID_PREFIX=breadboard
# Optional toolkit -> auth-config override for project-owned/custom configs:
# {"googlecalendar":"ac_..."}
COMPOSIO_AUTH_CONFIGS_JSON=

# Retained direct-OAuth fallback (currently inactive). Keep this configuration
# if you may switch back to Breadboard-owned provider credentials later.
BREADBOARD_PUBLIC_URL=http://localhost:3000
# Optional base64-encoded 32-byte vault key. When empty, Breadboard derives a
# separate vault key from NEXTAUTH_SECRET, which must remain stable.
BREADBOARD_CONNECTION_VAULT_KEY=
# Spotify's native inline player uses a public OAuth client with PKCE, never a
# client secret. Keep the callback identical to the URI registered in Spotify.
BREADBOARD_SPOTIFY_CLIENT_ID=cb7cb4f043ed42759672098759409ba8
BREADBOARD_SPOTIFY_OAUTH_CALLBACK_URL=http://127.0.0.1:3000/api/hermes/mcp/oauth/callback
# Optional base64-encoded 32-byte key for CalDAV calendar passwords (Profile ->
# Calendar sync). Same rule: when empty, one is derived from NEXTAUTH_SECRET,
# and changing either makes existing calendars ask for their password again.
BREADBOARD_CALENDAR_VAULT_KEY=
# How often a connected calendar is re-checked, in milliseconds. Default 15
# minutes; values under a minute are ignored. A calendar with local changes
# waiting is always re-checked within a minute regardless of this.
BREADBOARD_CALDAV_SYNC_INTERVAL_MS=
# Register this callback in each provider's developer application:
# http://localhost:3000/api/hermes/connections/oauth/callback
BREADBOARD_GOOGLE_CLIENT_ID=
BREADBOARD_GOOGLE_CLIENT_SECRET=
BREADBOARD_MICROSOFT_CLIENT_ID=
BREADBOARD_MICROSOFT_CLIENT_SECRET=
BREADBOARD_GITHUB_CLIENT_ID=
BREADBOARD_GITHUB_CLIENT_SECRET=
BREADBOARD_SLACK_CLIENT_ID=
BREADBOARD_SLACK_CLIENT_SECRET=
BREADBOARD_NOTION_CLIENT_ID=
BREADBOARD_NOTION_CLIENT_SECRET=
BREADBOARD_OAUTH_CREDENTIALS_JSON=

HERMES_BASE_URL=http://127.0.0.1:9129
HERMES_DASHBOARD_SESSION_TOKEN=
BREADBOARD_HERMES_TOOL_SECRET=
HERMES_CAPABILITY_SECRET=
HERMES_REQUEST_TIMEOUT_MS=120000
HERMES_MODE=required
# Per-session workspaces, kept separate from HERMES_HOME.
HERMES_ROOT=
HERMES_TERMINAL_AGENT=breadboard-assistant
HERMES_GARDEN_AGENT=breadboard-garden
HERMES_QUARTZ_AGENT=breadboard-quartz
HERMES_CAPABILITY_SCOUT_AGENT=breadboard-capability-scout

# --- Ruflo (hive-mind swarm agent) ----------------------------------------
# Ruflo plans a queen-led swarm over the Garden's connected repository and runs
# it through Claude Code, which it is designed to harness. Both executables are
# resolved automatically; these override the defaults.
#
# Path to the Ruflo clone. Defaults to <repo>/ruflo.
RUFLO_ROOT=
# Explicit Ruflo CLI (a binary, or a .js entry run with Node). When unset,
# Breadboard uses the built clone if `ruflo/v3/@claude-flow/cli/dist` exists and
# otherwise runs the published `@claude-flow/cli@<cloned version>` through npm.
RUFLO_BIN=
# Claude Code executable Ruflo swarms execute through. Defaults to `claude`.
RUFLO_CLAUDE_BIN=
# Claude Code model for swarm workers. Unset uses Claude Code's own default.
RUFLO_CLAUDE_MODEL=
# Swarms run with `--permission-mode acceptEdits` (file edits allowed, other
# tools still gated). Set to 1 to run with --dangerously-skip-permissions
# instead — unrestricted tool access in the connected repository.
RUFLO_DANGEROUSLY_SKIP_PERMISSIONS=

# URL the Hermes Breadboard plugin uses to call back into
# Breadboard (server-to-server, loopback). Defaults to http://127.0.0.1:3000.
BREADBOARD_INTERNAL_URL=http://127.0.0.1:3000

# Secret for signing short-lived capability tokens. Falls back to NEXTAUTH_SECRET
# when unset; set explicitly in production.

# Comma-separated extra origins allowed to call the public Quartz AI endpoints
# (in addition to the Quartz/dashboard defaults).
QUARTZ_AI_ALLOWED_ORIGINS=

# Skill lifecycle roots. General skills default to <repo>/.agents/skills for
# compatibility; reviewed coding skills use the separate conditional store.
HERMES_SKILLS_QUARANTINE=
HERMES_SKILLS_APPROVED=
HERMES_SKILLS_CONDITIONAL=
HERMES_FIRST_PARTY_SKILLS_ROOT=

# --- Interactive visualizer artifacts -------------------------------------
# First-party, authenticated Garden Chat and Terminal capability. Setting
# ENABLED=false or BROWSER_TESTS=false makes the tools explicitly unavailable;
# candidates are never published without the real browser gate.
INTERACTIVE_VISUALIZER_ENABLED=true
INTERACTIVE_VISUALIZER_BROWSER_TESTS=true
INTERACTIVE_VISUALIZER_THREE_ENABLED=true
INTERACTIVE_VISUALIZER_MAX_ATTEMPTS=3
INTERACTIVE_VISUALIZER_MAX_SOURCE_BYTES=80000
INTERACTIVE_VISUALIZER_MAX_BUNDLE_BYTES=1000000
INTERACTIVE_VISUALIZER_MAX_ARTIFACT_BYTES=2000000
INTERACTIVE_VISUALIZER_BROWSER_TIMEOUT_MS=22000
INTERACTIVE_VISUALIZER_MAX_THREE_OBJECTS=256
INTERACTIVE_VISUALIZER_MAX_VERTICES=100000

# Server-side Breadboard catalog proxy. The dashboard never sends credentials
# to this URL and never falls back directly to skills.sh. Loopback HTTP is
# accepted for proxy development; all non-loopback deployments must use HTTPS.
BREADBOARD_SKILLS_CATALOG_URL=https://breadboard-skills-catalog-kuzeyatay.vercel.app/api/v1

# --- Video transcription (Scriberr) ----------------------------------------
# Scriberr runs as Breadboard's bundled native Windows sidecar. No Docker or
# separate Scriberr setup is
# required. Breadboard talks to it over loopback HTTP. Scriberr defaults to
# port 8080, which the local Jina Reader also uses — remap Scriberr (e.g.
# "8091:8080" in docker compose, or SCRIBERR_PORT for scripts/start-scriberr)
# and point SCRIBERR_BASE_URL at the remapped port.
VIDEO_TRANSCRIPTION_ENABLED=true
SCRIBERR_BASE_URL=http://127.0.0.1:8091
# Optional external-service auth override. The managed native service creates
# and stores private credentials automatically.
SCRIBERR_API_TOKEN=
SCRIBERR_USERNAME=
SCRIBERR_PASSWORD=
SCRIBERR_REQUEST_TIMEOUT_MS=30000
SCRIBERR_TRANSCRIPTION_TIMEOUT_MS=21600000
SCRIBERR_POLL_INTERVAL_MS=3000
# Transcription parameters passed to Scriberr's start endpoint.
SCRIBERR_MODEL_FAMILY=whisper
SCRIBERR_MODEL=small
SCRIBERR_LANGUAGE=
SCRIBERR_DIARIZATION=false
# Delete the Scriberr-side job (and its media) after a successful import.
VIDEO_TRANSCRIPTION_DELETE_SCRIBERR_JOBS=false

VIDEO_TRANSCRIPTION_MAX_UPLOAD_MB=2048
VIDEO_TRANSCRIPTION_MAX_DURATION_SECONDS=21600
# Job-scoped temp media directory; defaults to the OS temp dir when empty.
VIDEO_TRANSCRIPTION_TEMP_DIR=
VIDEO_TRANSCRIPTION_KEEP_MEDIA=false
VIDEO_TRANSCRIPTION_TEMP_RETENTION_HOURS=24
VIDEO_TRANSCRIPTION_MAX_CONCURRENT=1
VIDEO_TRANSCRIPTION_MAX_QUEUED_PER_GARDEN=5

# External tools (used for YouTube metadata previews and upload validation).
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
YTDLP_DOWNLOAD_TIMEOUT_MS=1800000

# --- OfficeCLI (office_run/office_export agent tools; see root .env.example) --
# Provision the pinned binary with `npm run setup:officecli` (installs into
# .runtime/officecli). Set OFFICECLI_BIN only to pin a different binary;
# OFFICE_SKILLS_ROOT only if the OfficeCLI clone lives outside the repo root.
OFFICECLI_BIN=
OFFICE_SKILLS_ROOT=

# --- GBrain (garden knowledge retrieval; see root .env.example) -------------
# The dashboard reads these to reach the loopback GBrain adapter. GBRAIN_MODE and
# GBRAIN_ADAPTER_SECRET are normally injected by the dev launcher (scripts/dev-all.mjs);
# set them here for a standalone dashboard against a manually-started adapter.
# Unset resolves to `preferred`; `disabled` must be asked for explicitly.
GBRAIN_MODE=preferred
GBRAIN_ADAPTER_URL=http://127.0.0.1:7717
GBRAIN_ADAPTER_SECRET=
GBRAIN_QUERY_TIMEOUT_MS=15000

# --- Deep Research agent (see root .env.example) ----------------------------
# The dashboard reads these to reach the loopback research service. The secret is
# normally injected by the dev launcher (scripts/dev-all.mjs); set it here for a
# standalone dashboard against a manually-started service. The browser never
# receives it. FIRECRAWL_KEY / FIRECRAWL_BASE_URL belong to the SERVICE, not here.
DEEP_RESEARCH_MODE=optional
DEEP_RESEARCH_URL=http://127.0.0.1:7722
DEEP_RESEARCH_SECRET=
DEEP_RESEARCH_REQUEST_TIMEOUT_MS=15000

# --- Agent Reach agent ------------------------------------------------------
# Agent Reach is a local CLI, not a service: the dashboard runs `agent-reach
# doctor --json` to learn which platforms are reachable, then drives the upstream
# tools it routes to (yt-dlp, gh, mcporter, curl, …) through ChatMock. Both
# values are optional — a sibling `agent-reach/` checkout with a `.venv` is found
# automatically. Prepare that venv once with:
#   python -m venv agent-reach/.venv
#   agent-reach/.venv/bin/pip install -e agent-reach   (Scripts/ on Windows)
# AGENT_REACH_ROOT=
# AGENT_REACH_BIN=

# Optional developer override for the Agency Agents persona catalog.
# Desktop builds bundle the catalog and normal checkouts discover it automatically.
AGENCY_AGENTS_PATH=

# --- WhatsApp (see docs/WHATSAPP_INTEGRATION.md) ----------------------------
# Breadboard drives the Hermes Baileys bridge itself so an inbound WhatsApp
# message opens a real Terminal chat. Every value below is optional; the
# defaults work for a normal checkout and for the packaged desktop app.
# Linked-device credentials live on disk under Hermes, never here.
BREADBOARD_WHATSAPP_ENABLED=true
# BREADBOARD_WHATSAPP_BRIDGE_DIR=
# BREADBOARD_WHATSAPP_SESSION_DIR=
BREADBOARD_WHATSAPP_BRIDGE_PORT=8099
# BREADBOARD_WHATSAPP_NODE=
# Prepended to replies in self-chat mode; also the bridge's echo guard, so an
# empty value is only safe in bot mode.
# BREADBOARD_WHATSAPP_REPLY_PREFIX=
# Quiet period after which a WhatsApp thread opens a new chat instead of
# continuing the current one.
BREADBOARD_WHATSAPP_NEW_CHAT_AFTER_MINUTES=360

# --- Telegram (see docs/TELEGRAM_INTEGRATION.md) -----------------------------
# Breadboard long-polls Telegram's official Bot API from the server process, so
# an inbound Telegram message opens a real Terminal chat. Link a bot in
# Settings → Messaging; the token is written to disk under Hermes, never here.
BREADBOARD_TELEGRAM_ENABLED=true
# Supply the token from the environment instead of linking one in the app. It
# then wins over the stored file and cannot be removed from the UI.
# BREADBOARD_TELEGRAM_BOT_TOKEN=
# BREADBOARD_TELEGRAM_TOKEN_FILE=
# Point at a self-hosted Bot API server instead of api.telegram.org.
# BREADBOARD_TELEGRAM_API_BASE=
# Quiet period after which a Telegram thread opens a new chat instead of
# continuing the current one.
BREADBOARD_TELEGRAM_NEW_CHAT_AFTER_MINUTES=360

# The terminal dock's bar is a WebGL liquid-glass panel (@ybouane/liquidglass).
# It already stands down on its own without WebGL or when the OS asks for
# reduced transparency; set this to `off` to force the flat bar back.
# NEXT_PUBLIC_LIQUID_GLASS=off

# --- Parse with anydoc (local document → Markdown converter) -----------------
# The upload panel's "Parse with anydoc" option converts Word, PowerPoint,
# Excel, OpenDocument, RTF, EPUB, CSV and text-layer PDFs to clean GitHub-
# Flavored Markdown, keeping the headings, tables, lists and links that the
# older per-format text extractors flattened away. It is Firecrawl's anydoc
# (cloned at ../anydoc) via its Node bindings, so it runs on this machine in
# milliseconds and uses no ChatMock quota.
#
# Requirements: none beyond `npm install` — the @firecrawl/anydoc package ships
# a prebuilt binary. Set this to false to hide the option.
ANYDOC_ENABLED=true

# --- Parse using VLM (HunyuanOCR-1.5 GGUF) ----------------------------------
# The upload panel's "Parse using VLM" option reads every page of a PDF or
# image with Tencent's HunyuanOCR-1.5 running locally as a GGUF through
# llama.cpp's llama-server, and writes structured Markdown (headings, tables,
# LaTeX formulas). It runs entirely on this machine and uses no ChatMock quota.
#
# Requirements under Runtime V2 (desktop dev + packaged): the service runs
# with a CLOSED PATH (runtime bin, bundled node/python, System32), so a
# llama-server on the developer's PATH is invisible to it and the launch
# preflight refuses to start the service ("Runtime job control failed" on
# upload). Set VLM_OCR_SERVER_BINARY to an ABSOLUTE path — the pinned runtime
# staged by `npm run prepare:vlm-ocr` (desktop/resources/bin/vlm-ocr/) works.
# Packaged builds configure all three paths automatically.
# To run it yourself instead, set VLM_OCR_AUTO_START=false and start:
#   llama-server -hf ggml-org/HunyuanOCR-GGUF:Q8_0 --port 8077 --jinja
VLM_OCR_ENABLED=true
# 8077 avoids llama.cpp's default 8080 (taken by the local Jina Reader) and
# 8081 (Quartz).
VLM_OCR_BASE_URL=http://127.0.0.1:8077/v1
VLM_OCR_AUTO_START=true
# Absolute path required under Runtime V2; a bare name resolves only against
# <runtime-root>/bin, never the user PATH.
# VLM_OCR_SERVER_BINARY=C:\path\to\breadboard\desktop\resources\bin\vlm-ocr\runtime\llama-server.exe
# Model + matching mmproj (vision projector) are both pulled by `-hf`.
# VLM_OCR_HF_REPO=ggml-org/HunyuanOCR-GGUF:Q8_0
# Use already-downloaded GGUFs instead of the Hugging Face repo. Both required.
# VLM_OCR_MODEL_PATH=
# VLM_OCR_MMPROJ_PATH=
# Offload to the GPU; leave unset to let llama.cpp decide.
# VLM_OCR_GPU_LAYERS=99
# First start also downloads the weights, so the budget is generous.
# VLM_OCR_STARTUP_TIMEOUT_MS=600000
# VLM_OCR_REQUEST_TIMEOUT_MS=300000
# Upstream's own decoding settings for this model — change with care.
# VLM_OCR_MAX_TOKENS=4096
# VLM_OCR_TEMPERATURE=0
# VLM_OCR_TOP_K=1
# VLM_OCR_TOP_P=1
# VLM_OCR_REPEAT_PENALTY=1
# VLM_OCR_CONTEXT_SIZE=10240
# Width PDF pages are rendered at before OCR (the model handles up to 4K).
# VLM_OCR_PAGE_IMAGE_WIDTH=1400
# Cap pages per document; 0 means no cap.
# VLM_OCR_MAX_PAGES=0
# llama-server serves one slot by default, so raise this only if you gave it
# more with --parallel.
# VLM_OCR_CONCURRENCY=1

# --- Parametric CAD (local CadQuery/OpenCascade service) ---------------------
# Nothing is required here. The dashboard resolves the service on loopback port
# 7731 and reads a shared secret it creates under Breadboard's data directory,
# so `npm run dev`, `start.bat`, the desktop app and a hand-started
# `npm run dev:cad` all agree without any value being copied between them.
# Provision the Python environment once with `npm run setup:cad`.
#
# Set these only to override that:
# CAD_SERVICE_URL=http://127.0.0.1:7731
# CAD_SERVICE_SECRET=
# BREADBOARD_CAD_PORT=7731
# Where the secret and the per-execution workspaces live.
# BREADBOARD_CAD_HOME=
# CAD_MODE=optional      # `disabled` stops the dev stack starting it
#
# Editable engineering defaults. These are starting points, not facts; every
# value the agent uses is recorded in the design as an assumption.
# CAD_WALL_THICKNESS=2.4
# CAD_GENERAL_CLEARANCE=0.3
# CAD_PRESS_FIT_CLEARANCE=0.15
# CAD_SLIDING_FIT_CLEARANCE=0.35
# CAD_MINIMUM_FEATURE_SIZE=0.8
# CAD_MAXIMUM_OVERHANG_DEGREES=45
# CAD_PRINTER_BED=220x220x250

# --- Meta prompting ---------------------------------------------------------
# Every Hermes turn fixes the structure of the answer before its content, using
# the scaffolds parsed from the `meta-prompting/` clone (arXiv:2311.11482).
# On by default on all three surfaces; set to 0 to ship the plain prompts.
# ENABLE_META_PROMPTING=1
# Absolute path to the meta-prompting checkout. Defaults to the sibling clone;
# without it the scaffolds fall back to their embedded structures.
# META_PROMPTING_DIR=

# --- LoopX (see docs/LOOPX_INTEGRATION.md) ----------------------------------
# Long-running Hermes conversations are governed by the cloned LoopX control
# plane: it holds the objective, the owner gates, the todos, and the quota, and
# Breadboard ticks it after every completed turn. On by default for Terminal and
# Garden Chat; set to 0 to compose without any loop state.
# ENABLE_LOOPX=1
# Where the contained control-plane state lives. Defaults to
# dashboard/loopx-goals (the desktop build redirects it with BREADBOARD_DATA_DIR).
# BREADBOARD_LOOPX_HOME=
# The LoopX checkout and the interpreter that runs it. LoopX needs Python 3.11+
# and no third-party packages, so Breadboard reuses hermes-agent/.venv.
# BREADBOARD_LOOPX_ROOT=
# BREADBOARD_LOOPX_PYTHON=

# --- ComfyUI (the Advanced image mode) --------------------------------------
# The post studio's Advanced tab renders with your own model, sampler and seed.
# Managed local ComfyUI is configured only by the native Runtime V2 launcher;
# these bare-dashboard settings intentionally support external mode only.
#
# Set MANAGED=false and provide a credential-free HTTP(S) URL for a ComfyUI
# process you own. Breadboard observes it but never starts or stops it.
#
# Model files are never downloaded for you: put checkpoints in
# comfyui/models/checkpoints and the panel will list them.
COMFYUI_ENABLED=true
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_MANAGED=false
# COMFYUI_GENERATE_TIMEOUT_MS=600000

# --- Socials Manager (was: Postiz) ------------------------------------------
# The agent is Socials Manager; Postiz is the stack it publishes through. Every
# SOCIALS_MANAGER_* value below is still read under its old POSTIZ_* name, so an
# existing .env keeps working.
# SOCIALS_MANAGER_MODE=stack        # stack | adapter (draft locally) | disabled
# SOCIALS_MANAGER_URL=http://localhost:4007
# SOCIALS_MANAGER_ROOT=             # the postiz-app checkout
# SOCIALS_MANAGER_PROJECT=breadboard-postiz
# SOCIALS_MANAGER_READY_TIMEOUT_MS=20000
# SOCIALS_MANAGER_AUTOSTART_DOCKER=true
# SOCIALS_MANAGER_SUPPRESS_DOCKER_UI=true

# --- Inbox Zero --------------------------------------------------------------
# The real elie222/inbox-zero stack, run as containers from the vendored clone.
# Breadboard mints the app's own secrets and starts the containers itself, so
# nothing below is required — but the OAuth client is, and only you can create
# it. Set it here or in the agent's settings panel; a client set here wins.
#
# The Gmail client must list <INBOX_ZERO_URL>/api/auth/callback/google as an
# authorised redirect URI, or Google refuses the sign-in before it ever reaches
# Inbox Zero. Its AI runs on the local ChatMock, so no model key is needed.
# INBOX_ZERO_MODE=stack             # stack | disabled
# INBOX_ZERO_URL=http://localhost:4021
# INBOX_ZERO_ROOT=                  # the inbox-zero checkout
# INBOX_ZERO_PROJECT=breadboard-inbox-zero
# Ports are offset from the upstream defaults so a hand-run `docker compose up`
# in the clone does not collide with Breadboard's stack.
# INBOX_ZERO_PORT=4021
# INBOX_ZERO_POSTGRES_PORT=5442
# INBOX_ZERO_REDIS_PORT=6390
# INBOX_ZERO_REDIS_HTTP_PORT=8089
# The first start pulls four images and migrates a database.
# INBOX_ZERO_READY_TIMEOUT_MS=180000
# INBOX_ZERO_AUTOSTART_DOCKER=true
# INBOX_ZERO_SUPPRESS_DOCKER_UI=true
# INBOX_ZERO_GOOGLE_CLIENT_ID=
# INBOX_ZERO_GOOGLE_CLIENT_SECRET=
# INBOX_ZERO_MICROSOFT_CLIENT_ID=
# INBOX_ZERO_MICROSOFT_CLIENT_SECRET=

# --- mem0 semantic memory (see docs/MEM0_INTEGRATION.md) ---------------------
# durable_memories stays the canonical agent memory. mem0 (the vendored OSS
# engine in ../mem0/mem0-ts) adds a semantic index over the active rows, so a
# memory phrased nothing like the question can still be recalled. Retrieval
# fuses both channels by reciprocal rank; the deterministic policy — scope,
# state, confidence, salience, recency, the score cutoff — is unchanged.
#
# On by default: it rides the same keyless local embedding backend as every
# other retriever and falls back to lexical-only whenever that is unavailable.
# BREADBOARD_EMBEDDINGS=off disables this too.
# BREADBOARD_MEM0=off
#
# LLM fact extraction after each completed turn. Reads the whole exchange and
# proposes facts the user never phrased as an instruction. Every proposal is a
# reviewable `candidate` — extraction can never write a confirmed memory. Off
# by default: it costs one ChatMock call per turn.
# BREADBOARD_MEM0_EXTRACTION=on
# Extraction model. `default` is ChatMock's global background model.
# BREADBOARD_MEM0_LLM_MODEL=default
#
# The vendored engine builds itself as part of `npm run dev` (the clone
# gitignores its own dist/, so a fresh checkout has sources but no bundle). It
# is a no-op once built and never blocks the stack. `off` skips it; build it by
# hand with `npm run setup:mem0`.
# MEM0_AUTOSETUP=off

# --- Image search (the image_search chat tool) -------------------------------
# "Give me 5 images of an F-11" answers with an image grid. Works with zero
# setup: without saved credentials the tool uses DuckDuckGo's keyless image
# endpoint. Existing per-profile Google Custom Search credentials remain
# supported, but they are separate from the Gemini generation key in Profile.
# The vendored mcp-google-images-search MCP server still needs to be built once
# with `node scripts/setup-google-images.mjs`.
# Only to pin a clone that lives outside the repo root.
# BREADBOARD_GOOGLE_IMAGES_ROOT=

# --- Google image-generation fallback ---------------------------------------
# The Profile page can store one Gemini API key per user. ChatGPT image
# generation remains primary; Gemini runs only when that primary path fails.
# Optional base64-encoded 32-byte vault key. When empty, a separate key is
# derived from NEXTAUTH_SECRET, which must remain stable.
# BREADBOARD_GOOGLE_IMAGE_GENERATION_VAULT_KEY=
# Override Google's current native image model only when required.
# BREADBOARD_GOOGLE_IMAGE_GENERATION_MODEL=gemini-3.1-flash-image

# --- Recall (local screen + audio history) ---
# The dashboard installs, starts and stops the screenpipe capture engine itself;
# capture is opt-in per user in Settings -> Recall. RECALL_ENABLED=false removes
# the tab, the /api/recall routes, and the recall_* agent tools.
RECALL_ENABLED=true
RECALL_BASE_URL=http://127.0.0.1:3030
# Defaults to ~/.breadboard/recall. The desktop app overrides both with paths
# under its own data root.
RECALL_HOME=
RECALL_DATA_DIR=
RECALL_API_KEY=
RECALL_CLI_VERSION=0.4.37
RECALL_MAX_RESULTS=20
RECALL_MAX_RESULT_CHARS=1200

# --- Formsmith (local ShapeR image-to-3D agent) -----------------------------
# Formsmith accepts one JPEG, PNG or WebP and publishes a GLB artifact. It does
# not install ShapeR or download model weights during a request. Follow
# ../docs/SHAPER_INTEGRATION.md and ShapeR/INSTALL.md to provision the clone.
# SHAPER_ROOT=C:\path\to\ShapeR
# SHAPER_PYTHON=C:\path\to\shaper-environment\python.exe

# --- Prism (local DiffSynth Studio prompt-to-image agent) ------------------
# See ../docs/DIFFSYNTH_INTEGRATION.md. The run API never installs packages or
# downloads weights; use the documented CLI prefetch step once.
# DIFFSYNTH_STUDIO_ROOT=C:\path\to\diffsynth-studio
# DIFFSYNTH_PYTHON=C:\path\to\diffsynth-studio\.venv\Scripts\python.exe
# DIFFSYNTH_MODEL_BASE_PATH=C:\path\to\diffsynth-studio\models

# --- God's Eye (gods-eye-view live globe) ----------------------------------
# Defaults to ../gods-eye-view. The Vite dev server is the runtime and starts
# lazily with the first view; the Google Maps key is normally stored from the
# agent's settings dialog, but one exported here wins.
# GODS_EYE_ROOT=C:\path\to\gods-eye-view
# GODS_EYE_CREDENTIALS_FILE=C:\path\to\private\gods-eye-credentials.json
# GOOGLE_MAPS_API_KEY=

# --- openGym ---------------------------------------------------------------
# Defaults to ../openGym. The agent itself runs in Dashboard at startup; only
# animation GIFs are fetched lazily and cached when ./openGym/media/gif is absent.
# OPEN_GYM_ROOT=C:\path\to\openGym
# OPEN_GYM_AGENT_DATA_DIR=C:\path\to\private\open-gym-state
# OPEN_GYM_MEDIA_CACHE_DIR=C:\path\to\private\open-gym-media
# OPEN_GYM_MEDIA_BASE_URL=https://trusted.example/exercise-videos
