{
  "compilerOptions": {
    "target": "ES2018",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@genoffice/*": [
        "./src/vendor/genoffice/*/src"
      ],
      "@genoffice/pptx-engine/*": [
        "./src/vendor/genoffice/pptx-engine/src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "scripts",
    ".next-dev",
    ".next-desktop",
    ".next-production",
    ".next-production-final",
    ".next-schedcheck",
    "src/vendor/genoffice/pptx-render/src/bidi-js.d.ts",
    "openwork-runtime",
    "openwork-state",
    "openwork-workspace"
  ]
}
