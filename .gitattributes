# Quartz's public tree is generated build output, not authored source code.
quartz/public/** linguist-generated=true

# Keep Quartz program sources deterministic on Windows. Its build embeds
# source text in source maps, so CRLF checkouts otherwise change every page.
quartz/** text=auto eol=lf

# Vvveb is synchronized third-party editor output served by the dashboard.
# Preserve its upstream formatting without treating it as authored whitespace.
dashboard/public/vvveb-editor/** linguist-vendored=true -whitespace

