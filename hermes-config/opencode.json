{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "breadboard-assistant",
  "model": "chatmock/{env:CHATMOCK_MODEL}",
  "subagent_depth": 2,
  "provider": {
    "chatmock": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "ChatMock (Breadboard)",
      "options": {
        "baseURL": "{env:CHATMOCK_BASE_URL}",
        "apiKey": "{env:CHATMOCK_API_KEY}"
      },
      "models": {
        "default": {
          "name": "Background model (Settings -> Providers)",
          "reasoning": true,
          "variants": {
            "none": {
              "reasoningEffort": "none"
            },
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        },
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol",
