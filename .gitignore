/book-to-skill/
/career-ops/
/codex/
/comfyui/
/daily_stock_analysis/
/deep-research/
/deer-flow/
/emilkowalski-skills/
/hallmark/
/harvey-labs/
/hermes-agent/
/hyperframes/
/Resource2Skill/
/iFixAi/
/inbox-zero/
/loopx/
/manim/
/mem0/
/meta-prompting/
/n8n/
/nango/
/oh-my-hermes/
/open-alpha-arena/
/opencode/
/openscience/
/openwork/
/penecho/
/postiz-app/
/premortem/
/prompt-engineering-guide/
/reverse-skill/
/ruflo/
/scientific-agent-skills/
/screenpipe/
