# ---------------------------------------------------------------------------
# Secrets and machine-local configuration
# ---------------------------------------------------------------------------
.env
.env.*
!.env*.example
*.pem
recall/api-key

# ---------------------------------------------------------------------------
# OS and editor clutter
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/

# ---------------------------------------------------------------------------
# Dependencies — never commit, reinstall via npm/bun/uv install
# ---------------------------------------------------------------------------
node_modules/
.pnp
.pnp.*
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/

# ---------------------------------------------------------------------------
# Tool caches
# ---------------------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.turbo/
.quartz-cache/
.vercel/

# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
.next/
.next-*/
out/
dist/
build/
coverage/
*.tsbuildinfo
*.log

# Rust workspace build output
native/target/

# App Router route segments are directories, and some of them are named after
# build output ("…/api/document-skills/build"). Those are source, so the rules
# above must not reach inside the dashboard's source tree.
!dashboard/src/**/out/
!dashboard/src/**/dist/
!dashboard/src/**/build/
!dashboard/src/**/coverage/

# Desktop shell build artifacts
desktop/node_modules/
desktop/dist/
desktop/dist-tests/
desktop/build-resources/
desktop/resources/bin/
desktop/release/

# Playwright/vitest output (screenshots, traces, HTML reports)
dashboard/test-results/
dashboard/playwright-report/

# Isolated desktop QA runs and their diagnostic evidence. These can contain
# local account state, screenshots and traces, so they are never committed.
/.qa-runtime/
/.qa-results/
# Disposable isolated worktrees used for bounded QA repair experiments.
/.qa-worktrees/
/.tmp/

# ---------------------------------------------------------------------------
# Databases and runtime state
# ---------------------------------------------------------------------------
*.db
*.db-wal
*.db-shm
/runtime/
/runtime-v2/
dashboard/runtime-v2/
/database/

# Machine-local integration credentials and generated optimizer state.
/cliproxy/api-key
/cliproxy/management-key
/cliproxy/config.yaml
/cliproxy/auth/
/cliproxy/bin/
/.claude/proven-config.json
/.claude/.proven-config-version

# Breadboard Council run ledgers (JSONL/JSON, dev persistence)
.breadboard/

# Hermes runtime workspaces + skill quarantine (server-controlled, transient)
.runtime/
hermes-skills/quarantine/
hermes-skills/approved/
.agents/skills-quarantine/

# screenpipe install: its binary, capture data, minted bearer key and log.
# Everything under here is installed or written at runtime. Anchored, so the
# dashboard's own recall API routes are untouched.
/recall/

# Ruflo swarm state written into whichever repository a swarm runs in
.hive-mind/
.swarm/
.claude-flow/

# Unlazy's task-local acceptance ledgers and runtime state.
/.unlazy/

# ---------------------------------------------------------------------------
# Integrated upstream source snapshots
#
# The upstream projects used by Breadboard are committed as ordinary source
# files. Local nested .git metadata is never committed. Keep only disposable,
# unsafe, or reproducible bulk data out of the monorepo snapshot.
# ---------------------------------------------------------------------------
/.tmp-tiktok-downloader/
# Hijacked upstream clone kept only as evidence — contains a malware zip in
# bluely/; the skill was re-authored clean into hermes-skills/prebuilt/.
# Recommend deleting the directory outright.
/github-explorer-skill/
/openscience-workspace/

# Large upstream datasets, evaluation corpora, and generated media. These are
# not read by Breadboard at runtime and remain available from their upstreams.
/harvey-labs/tasks/
/hyperframes/packages/producer/tests/
/openGym/media/
/gods-eye-view/docs/media/
/PRAXIST/examples/rocket_booster_recovery_rust/vendor/
/pxpipe/eval/
/Resource2Skill/skills_wiki/
/screenpipe/crates/screenpipe-audio/onnxruntime-win-x64-1.22.0.zip

# Upstream private-key fixtures are intentionally not mirrored.
/openwork/apps/desktop/electron/testdata/chain-repair/*.key.pem
/stirling-pdf/app/core/src/test/resources/certs/test-key.key
/stirling-pdf/app/core/src/test/resources/certs/test-key.pem

# ---------------------------------------------------------------------------
# Per-agent generated workspaces, runs and installs
#
# Each of these is either something Breadboard installs for itself, a durable
# workspace an agent works inside, or the deliverables of a run. None of it is
# source, and some of it is large.
# ---------------------------------------------------------------------------

# Parametric CAD: the pinned Python environment lives under .runtime/ (already
# ignored above); these are the generated project files.
dashboard/cad-projects/

# HyperFrames: the scaffolded video projects (with their renders) and the
# HyperFrames CLI Breadboard installs into its own npm prefix.
dashboard/hyperframes-runs/
dashboard/openmaic-data/
dashboard/hyperframes-cli/
dashboard/resource2skill-runs/

# OpenMontage productions are deliverables and are never pruned.
dashboard/openmontage-runs/

# Vox Director: one project directory per production, laid out the way the
# clone lays its own out. The MP4 is the deliverable, so these are never pruned.
dashboard/vox-director-runs/

# OpenWork: the server Breadboard prepares out of the clone (source copy plus
# its npm install), the durable workspace the agent works inside, and the
# server's own config/tokens. All three are generated or user data.
dashboard/openwork-runtime/
dashboard/openwork-workspace/
dashboard/openwork-state/

# OpenScience: the pinned CLI Breadboard installs into its own npm prefix, the
# durable research workspace the agent works inside (its own git root, so its
# runs never treat this repository as their project), and the server's config,
# sessions and logs. All three are generated or user data.
dashboard/openscience-cli/
dashboard/openscience-workspace/
dashboard/openscience-state/

# Shorts: the videos a person picks in the composer before a run exists, and
# the downloads and cached transcripts a run reuses. Both are user data.
dashboard/shorts-uploads/
dashboard/shorts-work/

# Video Use: the retained originals and per-artifact edit workspaces.
dashboard/video-use/

# Socials Manager: the Postiz credentials and the compose file Breadboard
# writes for the stack it launches.
dashboard/postiz/

dashboard/loopx-goals/
dashboard/goal-mode/

# ---------------------------------------------------------------------------
# Chat and garden user data
#
# The databases, the artifacts a garden produced and the media a person
# attached to a chat. All of it belongs to the running instance, not the repo.
# The tracked screenshots and reports directly under dashboard/artifacts/ stay;
# only the per-garden directories are ignored.
# ---------------------------------------------------------------------------
dashboard/db/

# Mutable state the teaching subsystem creates on demand in the dev layout: the
# compiled capture helper, the lazily-installed speech environment and its model
# cache, demonstration recordings, and each learned workflow's compiled form.
# All of it is rebuilt or re-downloaded when needed; none of it is source.
dashboard/runtime/
dashboard/database/
dashboard/artifacts/[0-9]*/
dashboard/chat-videos/

# Disposable gardens created by actual-Electron development QA.
/quartz/content/
/quartz/public/
/quartz/.breadboard-quartz-publish*
/quartz/content/critical-qa-garden-*/
/quartz/content/hot-gbrain-smoke-*/

# Crash leftovers from the esbuild-backed document-editor integration test.
/dashboard/tests/artifact-document-editor-*.test.mjs

# graft's local graph cache — regenerable, not committed (run `graft build`).
graft/

# graft's local graph cache — regenerable, not committed (run `graft build`).
dashboard/.runtime/graft/breadboard-75cf7a099e62b7d2/
