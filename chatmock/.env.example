# Port
PORT=8000

# Image
CHATMOCK_IMAGE=storagetime/chatmock:latest

# Auth dir
CHATGPT_LOCAL_HOME=/data

# show request/stream logs
VERBOSE=false

# OAuth client id (modify only if you know what you're doing)
# CHATGPT_LOCAL_CLIENT_ID=app_EMoamEEZ73f0CkXaXp7hrann

# Reasoning controls
CHATGPT_LOCAL_REASONING_EFFORT=medium       # none|minimal|low|medium|high|xhigh
CHATGPT_LOCAL_REASONING_SUMMARY=auto        # auto|concise|detailed|none
CHATGPT_LOCAL_REASONING_COMPAT=think-tags   # legacy|o3|think-tags|current
CHATGPT_LOCAL_EXPOSE_REASONING_MODELS=false

# Enable default web search tool
CHATGPT_LOCAL_ENABLE_WEB_SEARCH=false

# Force a specific model name
# CHATGPT_LOCAL_DEBUG_MODEL=gpt-5.4

# ---------------------------------------------------------------------------
# Breadboard Council kernel (always-on intelligence layer behind ChatMock)
# ---------------------------------------------------------------------------
# Master switch. When true (default), every normal /v1/chat/completions
# request is council-mediated via chatmock_ask() -> CouncilRuntime.run().
ENABLE_COUNCIL=true

# Council seats. JSON array or comma-separated. Provider-prefixed ids
# ("vendor/model") are routed to OpenRouter when OPENROUTER_API_KEY is set;
# otherwise every seat falls back to the ChatGPT OAuth upstream.
COUNCIL_MODELS=["anthropic/claude-sonnet-4.5", "openai/gpt-5.1", "google/gemini-3-pro"]
CHAIRMAN_MODEL=anthropic/claude-sonnet-4.5

# Mode used for untagged requests that are not trivially short:
# direct_council | lite_council | full_council
DEFAULT_COUNCIL_MODE=direct_council

# OpenRouter access for multi-model councils (optional).
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Upstream model used when a provider-prefixed council seat is unreachable.
# COUNCIL_UPSTREAM_FALLBACK_MODEL=gpt-5.4

# Where CouncilRun ledgers are persisted (JSONL + JSON snapshots).
# Defaults to <repo root>/.breadboard/council-runs
# COUNCIL_LEDGER_DIR=

# Dev-only CouncilRun inspector: GET /debug/council-runs[/<runId>]
# ENABLE_COUNCIL_DEBUG=true
# Allow ?includePrompts=true to reveal redacted system prompts in run JSON.
# ENABLE_COUNCIL_DEBUG_PROMPTS=true
