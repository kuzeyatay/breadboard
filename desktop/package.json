{
  "name": "breadboard-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Breadboard desktop shell: Electron lifecycle owner and local service supervisor.",
  "main": "dist/main/main.js",
  "author": "Breadboard",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-static.mjs",
    "dev": "npm run build && npm run prepare:transcription && node scripts/dev.mjs",
    "start": "electron .",
    "test": "npm run build && node --test dist-tests/tests/*.test.js",
    "test:build": "tsc -p tsconfig.tests.json",
    "pretest": "npm run test:build",
    "build:dashboard": "node scripts/build-dashboard.mjs",
    "prepare:runtimes": "node scripts/prepare-runtimes.mjs",
    "prepare:runtime-supervisor": "node scripts/build-runtime-supervisor.mjs",
    "prepare:app": "node scripts/prepare-app-resources.mjs",
    "prepare:transcription": "node ../scripts/prepare-scriberr-runtime.mjs",
    "rebuild:native": "electron-rebuild -m ../dashboard -o better-sqlite3,bcrypt",
    "dist:win": "npm run build:dashboard && npm run prepare:runtime-supervisor && npm run prepare:runtimes && npm run prepare:app && npm run prepare:transcription && npm run build && node scripts/dist-win.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "smoke:hermes": "node scripts/hermes-runtime-smoke.mjs",
    "smoke:installed": "node scripts/installed-smoke-test.mjs"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@types/node": "^22.10.2",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "typescript": "^5.7.2"
  }
}
