{
  "name": "breadboard-desktop",
  "version": "0.1.2",
  "private": true,
  "description": "Breadboard desktop shell: Electron lifecycle owner and local service supervisor.",
  "main": "dist/main/main.js",
  "author": "Breadboard",
  "license": "MIT",
  "scripts": {
    "predev": "node ../dashboard/scripts/build-api-anything.mjs && node ../dashboard/scripts/build-quartz-runtime.mjs && node scripts/sync-dev-runtime-manifests.mjs",
    "build": "tsc -p tsconfig.json && node scripts/copy-static.mjs",
    "dev": "npm run build && npm run prepare:native-runtime && node scripts/prepare-hot-dev-runtimes.mjs && npm run prepare:computer-use && npm run prepare:transcription && node scripts/sync-dev-runtime-manifests.mjs --stage-runtime-bins && node scripts/dev.mjs",
    "start": "electron .",
    "test": "npm run build && node scripts/run-desktop-tests.mjs",
    "test:build": "tsc -p tsconfig.tests.json",
    "pretest": "npm run test:build",
    "build:dashboard": "node scripts/build-dashboard.mjs",
    "prepare:runtimes": "node scripts/prepare-runtimes.mjs",
    "prepare:solidworks": "node scripts/prepare-runtimes.mjs --only=solidworks-mcp",
    "prepare:solidworks:download": "node scripts/prepare-runtimes.mjs --only=solidworks-mcp --prefetch",
    "prepare:solidworks:offline": "node scripts/prepare-runtimes.mjs --only=solidworks-mcp --offline",
    "prepare:solidworks:source": "node scripts/prepare-solidworks-source.mjs",
    "prepare:vlm-ocr": "node scripts/prepare-vlm-ocr-runtime.mjs",
    "prepare:vlm-ocr:offline": "node scripts/prepare-vlm-ocr-runtime.mjs --offline",
    "prepare:computer-use": "node scripts/prepare-cua-driver-runtime.mjs",
    "prepare:computer-use:offline": "node scripts/prepare-cua-driver-runtime.mjs --offline",
    "prepare:native-runtime": "node scripts/build-runtime-supervisor.mjs",
    "prepare:runtime-supervisor": "npm run prepare:native-runtime",
    "prepare:app": "node scripts/prepare-app-resources.mjs",
    "prepare:transcription": "node ../scripts/prepare-scriberr-runtime.mjs",
    "rebuild:native": "electron-rebuild -m ../dashboard -o better-sqlite3,bcrypt",
    "dist:win": "npm run build:dashboard && npm run prepare:native-runtime && npm run prepare:runtimes && npm run prepare:app && npm run prepare:transcription && npm run build && node scripts/dist-win.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "smoke:hermes": "node scripts/hermes-runtime-smoke.mjs",
    "smoke:installed": "node scripts/installed-smoke-test.mjs"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@ghostery/adblocker": "2.20.1",
    "@ghostery/adblocker-content": "2.20.1",
    "@ghostery/adblocker-extended-selectors": "2.20.1",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.18.1",
    "electron": "43.8.10",
    "electron-builder": "^25.1.8",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "selfsigned": "5.5.0",
    "typescript": "^5.7.2",
    "web-push": "^3.6.7",
    "jsonc-parser": "3.3.1"
  },
  "dependencies": {
    "http_ece": "^1.2.1",
    "ws": "^8.18.3"
  }
}
