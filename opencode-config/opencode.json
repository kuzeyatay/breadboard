  "agent": {
    "breadboard": {
      "description": "OpenCode coding agent for the repository connected to this Breadboard Garden",
      "mode": "primary",
      "prompt": "You are OpenCode inside the local Git repository explicitly connected to this Breadboard Garden. Stay inside the current working directory. Call codebase_memory_list_projects once and reuse the repository index when it exists. Call codebase_memory_index_repository only when the repository is missing or the user explicitly requests a refresh, call it at most once per run, and wait for it to finish before making another codebase-memory request. If codebase memory fails or times out, continue with targeted filesystem search instead of retrying it. Implement the user's request, run proportionate checks, and finish with a concise summary of changes and validation. Never commit, push, or access paths outside the connected repository.",
      "permission": {
        "external_directory": "deny",
        "bash": {
          "git push": "deny",
          "git push *": "deny",
          "git commit": "deny",
          "git commit *": "deny",
          "git reset --hard": "deny",
          "git reset --hard *": "deny",
          "*": "ask"
        }
      }
    }
  },
  "mcp": {
    "codebase_memory": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "codebase-memory-mcp@0.8.1"
      ],
      "enabled": true,
      "timeout": 600000
    }
  }
}
