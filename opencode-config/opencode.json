{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "breadboard",
  "model": "chatmock/{env:CHATMOCK_MODEL}",
  "provider": {
    "chatmock": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "ChatMock (Breadboard)",
      "options": {
        "baseURL": "{env:CHATMOCK_BASE_URL}",
        "apiKey": "{env:CHATMOCK_API_KEY}"
      },
      "models": {
        "default": {
          "name": "Background model (Settings -> Providers)",
          "reasoning": true,
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "none": {
              "reasoningEffort": "none"
            },
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        },
