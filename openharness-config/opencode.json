{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "breadboard-terminal",
  "model": "chatmock/{env:CHATMOCK_MODEL}",
  "subagent_depth": 1,
  "provider": {
    "chatmock": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "ChatMock (Breadboard)",
      "options": {
        "baseURL": "{env:CHATMOCK_BASE_URL}",
        "apiKey": "{env:CHATMOCK_API_KEY}"
      },
      "models": {
        "{env:CHATMOCK_MODEL}": { "name": "ChatMock model" }
      }
    }
  },
  "permission": {
    "external_directory": {
      "*": "ask"
    }
  }
}
