# OpenHarness server process (normally populated by scripts/start-openharness.*)
OPENCODE_SERVER_USERNAME=breadboard
OPENCODE_SERVER_PASSWORD=breadboard-local-dev
OPENCODE_CONFIG_DIR=../openharness-config

# ChatMock provider used by openharness-config/opencode.json.
CHATMOCK_BASE_URL=http://127.0.0.1:8765/v1
CHATMOCK_API_KEY=local
CHATMOCK_MODEL=gpt-5
